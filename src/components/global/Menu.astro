---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Knight from '../../assets/Knight_06.png';

import fih from '../../assets/fih.jpg'
import throne from '../../assets/throne.jpg';
import catnerd from '../../assets/cat-nerd.png';
import uwu from '../../assets/uwu.jpg'

import AppSVG from '../ui/AppSVG.astro';
import MenuList from '../ui/MenuList.astro';
import Watermark from '../ui/Watermark.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/Knight_06-ASCII-SCALE-[0-9]x.png', { eager: true });

const optimizedImageUrls = await Promise.all(
    Object.values(images).map(async (mod: any) => {
        const optimized = await getImage({
        src: mod.default,
        format: 'webp',  
        width: 1200,      
        });
        return optimized.src; 
    })
);

const KnightBGFrames: string[] = optimizedImageUrls;
const exportedKnightBGFrames = JSON.stringify(KnightBGFrames);
const optimizedBGFrame = await getImage({ src: Knight });

const socials = await getCollection('socials');
const professionalSocials = socials.filter(social => social.data.featured);

const projects = await getCollection('projects');
const MAX_FEATURED = 4;

const featuredProjects = projects
    .filter(project => project.data.featured)
    .slice(0, MAX_FEATURED);

const menuListItems = [
{ label: 'About', image: fih, alt: "Learn more about me" },
{ label: 'Home', image: throne, alt: "Visit my portfolio" },
{ label: 'Projects', image: uwu, alt: "Check out my work" },
{ label: 'Contact', image: catnerd, alt: "Let's get in touch" },
// { label: 'Resume', image: fih, alt: "Download my pdf" },
];

type MenuType = "nav" | "footer";

type Props = {
    variant: MenuType;
}

const { variant } = Astro.props
const variantType = variant === 'nav' ? 'full-menu' : 'reveal-footer';
---

<div class="menu menu--full-size" id={variantType}>
    <div class="menu__background" data-bg-frames={exportedKnightBGFrames} id="menu-bg">
        <div class="menu__background__image" id="menu-image" style={`background-image: url('${optimizedBGFrame.src}')`}></div>
    </div>
    <div class="menu__nav">
        <MenuList items={menuListItems}/>
        <div class="hover-reveal" id="hover-reveal"></div>
    </div>

    <div class="menu__links">
        <div class="menu__links__socials">
            {professionalSocials.map(social => {
                return <a class="menu__links__socials__link" href=`{social.data.link}`>{social.data.platform}</a>
            })}
        </div>

        <div class="menu__links__content">
            <div class="menu__links__content__nav">
                <div class="info-group">
                    <h4 class="info-group__header">Projects ({featuredProjects.length})</h4>
                    {featuredProjects.map(project=> {
                        if (project.data.featured) {
                            return <a class="info-group__link" href=`/projects/${project.data.id}`>{project.data.title}</a>
                        }
                    })}
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">Explore</h4>
                    <a class="info-group__link" href="/quest">Start a quest</a>
                    <a class="info-group__link" href="/sign">Sign the guestbook</a>
                    <a class="info-group__link" href="/now">What am I doing?</a>
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">Other pages</h4>
                    <a class="info-group__link" href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
                    <a class="info-group__link" href="/thoughts">Thoughts</a>
                </div>
            </div>
            <div class="menu__links__content__info">
                <div class="menu__links__content__info__flags">
                    <AppSVG icon="us-flag" width={30} height={15}/>
                    <AppSVG icon="house-hightower" width={60} height={60} />
                </div>
                <div class="menu__links__content__info__text">
                    <a href="/sitemap"> Settings </a>
                    <p title="This website was developed without AI"> Designed, developed and deployed by </p>
                    <p title="This website was developed without AI"> Oswaldo Fabrizio De Lo Santos Ascencio </p>
                </div>
            </div>
        </div>
    </div>
    <!--
        <div class="menu__title">
            <h1> Oswaldo De Los Santos Fabrizio Ascencio </h1>
        </div>
    -->
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .hover-reveal {
        position: fixed;
        top: 0; left: 0;
        opacity: 0;
        pointer-events: none;

        width: 100px;
        height: 100px;

        background: white;

        background-image: none;
        background-size: cover;
        background-position: center;

        &.is-visible {
            z-index: 1000;
            opacity: 1;
        }
    }

    .menu {
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        background-color: var(--primary-color);
        color: var(--secondary-color);

        overflow-y: hidden !important;
        
        width: 100vw;
        height: 100vh;
        
        
        // padding-top: 10vw;
        padding-top: 20vh;
        
        
        &#full-menu {
            position: fixed;
            top: 0; left: 0;
            inset: 0;
            
            overflow: hidden; 
            overscroll-behavior: none; 
            z-index: var(--menu-layer); 
            transition: clip-path 300ms ease-in;
            clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);

            .menu__title {
                display: none;
            }
        }

        &#reveal-footer {
            background-color: var(--color-primary-20);
            background-color: var(--color-secondary-01);
            margin-top: 50px;
            position: static;
            z-index: var(--footer-layer);
            height: 100vh;


            & #menu-bg {
                display: none;
            }
        }

        &__background {
            position: relative;

            &__image {
                position: absolute;

                // height: 80vh; width: 30vw;
                top: -5vw; 
                top: -60px;

                top: -14vh; right: -3vw;
                height: 80vh;

                height: 70vh;
                top: -5vh;
                // top: 20%;
                top: -5rem;
                // width: 20vw;

                
                background-image: url(https://picsum.photos/2000);
                background-size: cover;
                background-position: bottom right;
                background-repeat: no-repeat;
                
                transition: 1s ease-in-out right;
                
                z-index: 1;
                user-select: none;
                // pointer-events: none;
                
                width: 300px;
                width: 540px;
                background-position: center;
                &.full-width {
                    width: 100vw;
                    top: -13vh; 
                    background-position: right;
                    background-repeat: no-repeat;
                    background-size: contain;
                }

                &:hover {
                    // background-color: var(--color-secondary-01);
                }
            }
        }

        &__nav {
            display: flex;
            flex-direction: column;
            width: 95%;

            margin-bottom: 5vh;
        }

        &__links {
            margin-bottom: 1rem;
            
            &__socials {
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: space-around;
                // width: 40%;
                width: 60%;
                margin-bottom: 1rem;

                &__link {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-xs);
                    color: var(--color-secondary-60);
                    text-decoration: none;
                    transition: 200ms all ease;

                    &:hover {
