    @media (max-width: 320px) {
        
    }

    @media (max-width: 425px) {
        
    }

    @media (max-width: 768px) {

        .info-group:first-of-type {
            order: 3;
        }

        .menu__links__content__nav {
            flex-wrap: wrap;
            flex-wrap: balance;
        }

        .menu__links__content {
            flex-wrap: wrap;
            flex-wrap: balance;
        }

        .menu__links__content__info {
            flex-direction: column-reverse;
            gap: 0;
        }

        .menu__links__content__info__text {
            margin: 2rem;
            & * > {
                text-align: center !important;
            }

            a, p {
                text-align: center !important;
            }
        }
        
        .menu__links__content__info__flags {
            // display: none;
            flex-direction: row;
            justify-content: center;
            width: 100%;
        }

             
        .menu {
            padding-top: 20vh;

            &#full-menu {
                inset: unset;
                z-index: 5;              
                padding-top: none;  
                height: 100dvh !important;
                overflow-y: scroll !important; 
                overscroll-behavior: initial; 
            }
        }

        .menu__list {
            width: 95%;
        }

        .menu__nav {
            width: 95%;
        }

        .menu__background__image {
            display: none;
        }

        .menu__links__socials {
