---
import Image from 'astro/components/Image.astro';
import Knight from '../../assets/Knight.png';
import KnightASCII from '../../assets/Knight-ASCII.png';
import MenuList from '../ui/MenuList.astro';
import Watermark from '../ui/Watermark.astro';
---

<div class="menu menu--full-size" id="full-menu">

    <Watermark />
    <div class="menu__background">
        <Image 
            class="menu__background__image"
            src={KnightASCII}
            alt="Infinity blade">
        </Image>
    </div>
    <div class="menu__nav">
        <MenuList items={['About', 'Home', 'Contact', 'Projects']}/>
    </div>

    <div class="menu__links">
        <div class="menu__links__socials">
            <a class="menu__links__socials__link" href="https://www.instagram.com/byoswwwaldo/"> Instagram </a>
            <a class="menu__links__socials__link" href="https://github.com/oswwwaldo"> Github </a>
            <a class="menu__links__socials__link" href="https://www.linkedin.com/in/oswwwaldo/"> LinkedIn </a>
            <a class="menu__links__socials__link" href="https://www.youtube.com/@oswwwaldo"> YouTube </a>
        </div>

        <div class="menu__links__content">
            <div class="menu__links__content__nav">
                <div class="info-group">
                    <h4 class="info-group__header">Projects (04)</h4>
                    <a class="info-group__link" href="/projects/spotify-lyrics-display">Spotify Lyrics Display</a>
                    <a class="info-group__link" href="/projects/portfolio">Portfolio</a>
                    <a class="info-group__link" href="/projects/new-tab-chess">New Tab Chess Puzzle</a>
                    <a class="info-group__link" href="/projects/robco-industries-terminal">RobCo Industries Terminal</a>
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">Explore</h4>
                    <a class="info-group__link" href="/projects/start-a-quest">Start a quest</a>
                    <a class="info-group__link" href="/projects/sign">Sign the guestbook</a>
                    <a class="info-group__link" href="/projects/now">What am I doing?</a>
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">Other pages</h4>
                    <a class="info-group__link" href="/now">Now</a>
                    <a class="info-group__link" href="/thoughts">Thoughts</a>
                    <a class="info-group__link" href="/video">Video</a>
                    <a class="info-group__link" href="/drop">Drop</a>
                </div>
            </div>
            <div class="menu__links__content__info">
                <div class="menu__links__content__info__flags">
                    <div class="us-flag">
                        <svg width="30" height="15" viewBox="0 0 30 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.04 6.72H30V8.28H13.04V6.72Z" fill="var(--color-flag-red)"/>
                            <path d="M0 10.08H30V11.64H0V10.08Z" fill="var(--color-flag-red)"/>
                            <path d="M0 13.44H30V15H0V13.44Z" fill="var(--color-flag-red)"/>
                            <path d="M13.04 3.36H30V4.92H13.04V3.36Z" fill="var(--color-flag-red)"/>
                            <path d="M13.04 0H30V1.56H13.04V0Z" fill="var(--color-flag-red)"/>
                            <path d="M0 0H11.04V8.28H0V0Z" fill="var(--color-flag-blue)"/>
                        </svg>
                    </div>
                </div>
                <div class="menu__links__content__info__text">
                    <a href="/sitemap"> Sitemap </a>
                    <p> Designed, developed and deployed by </p>
                    <p> Oswaldo Fabrizio De Lo Santos Ascencio </p>
                </div>
            </div>
        </div>
    </div>

</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .menu {
        display: none;
        flex-direction: column;
        justify-content: space-around;

        background-color: var(--primary-color);
        color: var(--secondary-color);

        
        overflow-y: hidden !important;
        
        position: fixed;
        left: 0; top: 0;
        inset: 0;
        width: 100vw;
        height: 100vh;
        
        overflow: hidden; 
        overscroll-behavior: none; 
        z-index: var(--menu-layer);

        &--full-size {
            padding-top: 20vh !important;
        }


        &__background {
            position: relative;

            &__image {
                position: absolute;
                top: -22vh; right: 0;
                
                height: 90vh;
                width: auto;
                
                object-fit: contain;
                z-index: -1;

                // ! This doesn't work
                // opacity: calc(100 * var(--opacity-factor) / 100);
            }
        }

        &__nav {
            display: flex;
            flex-direction: column;
            width: 100%;

            margin-bottom: 10vh;
        }

        &__links {
            margin-bottom: 1rem;
            &__socials {
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: space-around;
                width: 33%;
                margin-bottom: 1rem;

                &__link {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-xs);
                    color: var(--color-secondary-60);
                    text-decoration: none;
                    transition: 200ms all ease;

                    &:hover {
                        color: var(--color-secondary);
                    }
                }
            }

            &__content {
                display: flex;
                flex-direction: row;
                justify-content: space-around;
                border-top: var(--border-thin-secondary-20);
                padding-top: 1rem;

                &__nav {
                    display: flex;
                    flex-direction: row;
                    align-items: flex-start;
                    justify-content: flex-start;

                    padding: 0 2rem;
                    gap: 10vw;

                    min-height: 136px;

                    flex-grow: 1;
                    z-index: 0;

                    .info-group {
                        display: flex;
                        flex-direction: column;
                        align-items: flex-start;
                        gap: 0.5rem;

                        &__header {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            color: var(--secondary-color);
                            letter-spacing: 1.3px;
                        }

                        &__link {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            color: var(--color-secondary-60);
                            letter-spacing: 0.8px;
                            text-decoration: none;
                            transition: 200ms all ease;

                            &:hover {
                                color: var(--color-secondary);
                            }
                        }
                    }
                }

                &__info {
                    display: flex;
                    align-items: flex-start;
                    flex-direction: row-reverse;
                    gap: 2rem;

                    padding: 0 2rem;

                    &__flags {
                        display: flex;
                        flex-direction: column;

                        &__us-flag {
                            fill: var(--color-gray);
                        }
                    }

                    &__text {
                        display: flex;
                        flex-direction: column;
                        
                        a, p {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            text-align: right;
                            color: var(--color-secondary-60);
                        }
                        
                        a {
                            color: var(--color-secondary);
                            text-decoration: none;
                        }

                    }
                }
            }
        }
    }

    @media (max-width: 425px) {
        
    }

    @media (max-width: 768px) {

    }

    @media (max-width: 1024px) {
        
    }

</style>

<script>
    function updateMenuHeight() {
        const menu = document.getElementById('reveal-menu');
        if (menu) {
            const observer = new ResizeObserver(() => {
                document.documentElement.style.setProperty('--menu-height', `${menu.offsetHeight}px`);
            });
            observer.observe(menu);
        }
    }

    updateMenuHeight();
</script>