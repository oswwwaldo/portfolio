---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Image from 'astro/components/Image.astro';

import Knight from '../../assets/Knight_06.png';
import KnightASCII1x from '../../assets/Knight_06-ASCII-SCALE-1x.png';
import KnightASCII2x from '../../assets/Knight_06-ASCII-SCALE-2x.png';
import KnightASCII3x from '../../assets/Knight_06-ASCII-SCALE-3x.png';
import KnightASCII4x from '../../assets/Knight_06-ASCII-SCALE-4x.png';
import KnightASCII5x from '../../assets/Knight_06-ASCII-SCALE-5x.png';
import KnightASCII6x from '../../assets/Knight_06-ASCII-SCALE-6x.png';
import KnightASCII7x from '../../assets/Knight_06-ASCII-SCALE-7x.png';
import KnightASCII8x from '../../assets/Knight_06-ASCII-SCALE-8x.png';

import fih from '../../assets/fih.jpg'
import throne from '../../assets/throne.jpg';
import catnerd from '../../assets/cat-nerd.png';
import uwu from '../../assets/uwu.jpg'

import AppSVG from '../ui/AppSVG.astro';
import MenuList from '../ui/MenuList.astro';
import Watermark from '../ui/Watermark.astro';

const KnightBGFrames = [ Knight.src, KnightASCII1x.src, KnightASCII2x.src, KnightASCII3x.src, KnightASCII4x.src, KnightASCII5x.src, KnightASCII6x.src, KnightASCII7x.src, KnightASCII8x.src ]
const exportedKnightBGFrames = JSON.stringify(KnightBGFrames);


// const rawImageMetadata = entry.data.src; // This holds your ImageMetadata object

const optimizedBGFrame = await getImage({ src: Knight });

const socials = await getCollection('socials');
const professionalSocials = socials.filter(social => social.data.featured);

console.log('Socials in <Menu/>: ' + professionalSocials.length);

const projects = await getCollection('projects');
const MAX_FEATURED = 4;

const featuredProjects = projects
    .filter(project => project.data.featured)
    .slice(0, MAX_FEATURED);

console.log('Projects in <Menu/>: ' + featuredProjects.length);

const menuListItems = [
  { label: 'About', image: fih, alt: "Yo what up my g" },
  { label: 'Home', image: throne, alt: "Yo what up my o" },
  { label: 'Contact', image: catnerd, alt: "Yo what up my oo" },
  { label: 'Projects', image: uwu, alt: "Yo what up my ooo" },
];


type MenuType = "nav" | "footer";

type Props = {
    variant: MenuType;
}

const { variant } = Astro.props
const variantType = variant === 'nav' ? 'full-menu' : 'reveal-footer';
---

<div class="menu menu--full-size" id={variantType}>
    <div class="menu__background" data-bg-frames={exportedKnightBGFrames} id="menu-bg">
        <div class="menu__background__image" id="menu-image" style={`background-image: url('${optimizedBGFrame.src}')`}></div>
        <!-- 
        <Image 
            class="menu__background__image"
            id="menu-image"
            src={KnightASCII3x}
            alt="Infinity Blade">
        </Image> -->
    </div>
    <div class="menu__nav">
        <MenuList items={menuListItems}/>
        <div class="hover-reveal" id="hover-reveal"></div>
    </div>

    <div class="menu__links">
        <div class="menu__links__socials">
            {professionalSocials.map(social => {
                return <a class="menu__links__socials__link" href=`{social.data.link}`>{social.data.platform}</a>
            })}
        </div>

        <div class="menu__links__content">
            <div class="menu__links__content__nav">
                <div class="info-group">
                    <h4 class="info-group__header">Projects ({featuredProjects.length})</h4>
                    {featuredProjects.map(project=> {
                        if (project.data.featured) {
                            return <a class="info-group__link" href=`/projects/${project.data.id}`>{project.data.title}</a>
                        }
                    })}
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">Explore</h4>
                    <a class="info-group__link" href="/start-a-quest">Start a quest</a>
                    <a class="info-group__link" href="/sign">Sign the guestbook</a>
                    <a class="info-group__link" href="/now">What am I doing?</a>
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">Other pages</h4>
                    <a class="info-group__link" href="/changelog">Changelog</a>
                    <a class="info-group__link" href="/music">Music</a>
                    <a class="info-group__link" href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
                    <a class="info-group__link" href="/thoughts">Thoughts</a>
                </div>
            </div>
            <div class="menu__links__content__info">
                <div class="menu__links__content__info__flags">
                    <AppSVG icon="us-flag" width={30} height={15}/>
                    <AppSVG icon="house-hightower" width={60} height={60} />
                </div>
                <div class="menu__links__content__info__text">
                    <a href="/sitemap"> Sitemap </a>
                    <p> Designed, developed and deployed by </p>
                    <p> Oswaldo Fabrizio De Lo Santos Ascencio </p>

                    <br> <br>
                    <a href="/credits"> Credits </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .hover-reveal {
        position: fixed;
        top: 0; left: 0;
        opacity: 0;
        pointer-events: none;

        width: 100px;
        height: 100px;

        background: white;

        background-image: none;
        background-size: cover;
        background-position: center;

        &.is-visible {
            z-index: 1000;
            opacity: 1;
        }
    }

    .menu {
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        background-color: var(--primary-color);
        color: var(--secondary-color);

        overflow-y: hidden !important;
        
        width: 100vw;
        height: 100vh;
        
        
        padding-top: 20vh !important;
        
        
        &#full-menu {
            position: fixed;
            top: 0; left: 0;
            inset: 0;
            
            overflow: hidden; 
            overscroll-behavior: none; 
            z-index: var(--menu-layer); 
            transition: clip-path 300ms ease-in;
            clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
        }

        &#reveal-footer {
            background-color: var(--color-primary-20);
            background-color: var(--color-secondary-03);
            margin-top: 50px;
            position: static;
            z-index: var(--footer-layer);
        }

        &__background {
            position: relative;

            &__image {
                position: absolute;

                height: 80vh; width: 40vw;
                top: -20vh; right: 1vw;

                // background-color: var(--color-secondary-20);
                background-image: url(https://picsum.photos/200);
                background-size: cover;
                background-position: bottom center;

                z-index: 1;
                user-select: none;
                // pointer-events: none;

                &:hover {
                    // background-color: var(--color-secondary-01);
                }
            }
        }

        &__nav {
            display: flex;
            flex-direction: column;
            width: 100%;

            margin-bottom: 10vh;
        }

        &__links {
            margin-bottom: 1rem;
            
            &__socials {
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: space-around;
                width: 33%;
                margin-bottom: 1rem;

                &__link {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-xs);
                    color: var(--color-secondary-60);
                    text-decoration: none;
                    transition: 200ms all ease;

                    &:hover {
                        color: var(--color-secondary);
                    }
                }
            }

            &__content {
                display: flex;
                flex-direction: row;
                justify-content: space-around;
                border-top: var(--border-thin-secondary-20);
                padding-top: 1rem;

                &__nav {
                    display: flex;
                    flex-direction: row;
                    align-items: flex-start;
                    justify-content: flex-start;

                    padding: 0 2rem;
                    gap: 10vw;

                    min-height: 136px;

                    flex-grow: 1;
                    z-index: 0;

                    .info-group {
                        display: flex;
                        flex-direction: column;
                        align-items: flex-start;
                        gap: 0.5rem;

                        &__header {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            color: var(--secondary-color);
                            letter-spacing: 1.3px;
                        }

                        &__link {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            color: var(--color-secondary-60);
                            letter-spacing: 0.8px;
                            text-decoration: none;
                            transition: 200ms all ease;

                            &:hover {
                                color: var(--color-secondary);
                            }
                        }
                    }
                }

                &__info {
                    display: flex;
                    align-items: flex-start;
                    flex-direction: row-reverse;
                    gap: 2rem;

                    padding: 0 2rem;

                    &__flags {
                        display: flex;
                        align-items: center;
                        flex-direction: column;
                        justify-content: center;
                        gap: 1rem;

                        fill: var(--color-gray) !important;
                    }

                    &__text {
                        display: flex;
                        flex-direction: column;
                        
                        a, p {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            text-align: right;
                            color: var(--color-secondary-60);
                        }
                        
                        a {
                            color: var(--color-secondary);
                            text-decoration: none;
                        }

                    }
                }
            }
        }
    }

    @media (max-width: 425px) {
        
    }

    @media (max-width: 768px) {

    }

    @media (max-width: 1024px) {
        
    }

</style>

<script>
    const menuBG = document.getElementById('menu-bg') as HTMLDivElement;
    const menuBGFrames = menuBG?.dataset.bgFrames;
    const menuImage = document.getElementById('menu-image');
    let isCursorInside = false;
    console.log(menuBGFrames);

    if (menuBG && menuBGFrames && menuImage) {
        console.log("if menuBG && menuBGFrames && menuImage fired");
        const bgFrames = JSON.parse(menuBGFrames);
        console.log(bgFrames);
        console.log(typeof(bgFrames));
        console.log("Exported frames recovered: " + bgFrames.length);

        menuImage.addEventListener('mousemove', (event) => {
            console.log("event listener mousemove event fired");

            const menuRect = menuImage?.getBoundingClientRect();
            const divStartsAtX = menuRect.left;
            const divEndsAtX = menuRect.right;

            // If cursor touches element
            if (event.clientX > divStartsAtX && event.clientX < divEndsAtX) {
                console.log("cursor touching element + > divStartsAtX && < divEndsAtX");

                const divWidth = menuRect.width;
                const cursorProgress = event.clientX - divStartsAtX;
                const divQuadrant = divWidth / bgFrames.length;
                const currentQuadrant = Math.floor((cursorProgress / divWidth) * bgFrames.length); // returns 0 to 8

                console.log("The cursor is in " + currentQuadrant);
                menuImage.style.backgroundImage = `url('${bgFrames[currentQuadrant]}')`;
            }
            isCursorInside = true;
        });
    }

    function updateMenuHeight() {
        const menu = document.getElementById('reveal-menu');
        if (menu) {
            const observer = new ResizeObserver(() => {
                document.documentElement.style.setProperty('--menu-height', `${menu.offsetHeight}px`);
            });
            observer.observe(menu);
        }
    }

    updateMenuHeight();

    const hoverReveal = document.getElementById('hover-reveal') as HTMLDivElement;
    const menuNav = document.querySelector('.menu__nav');
    console.log("Checking...");  
    
    document.addEventListener('mousemove', (event) => {
        hoverReveal.style.top = `${25 + event.clientY}px`;
        hoverReveal.style.left = `${25 + event.clientX}px`;
    });

    menuNav?.querySelectorAll('* > [data-image]').forEach(menuListItem => { 
        // console.log("Hello" + menuListItem.getAttribute('title'));
        // console.log(menuListItem.dataset.image); 

        menuListItem.addEventListener('mouseenter', () => {
            // console.log("You're hovering over " + menuListItem.textContent);
            // console.log(menuListItem.dataset.image);
            if (hoverReveal) { hoverReveal.style.backgroundImage = 'url(`${menuListItem.dataset.image}`)'; }

            if (hoverReveal) {
                hoverReveal.style.backgroundImage = `url("${menuListItem.dataset.image}")`;
                hoverReveal.classList.add('is-visible');
            }
        });

        menuListItem.addEventListener('mouseleave', () => {
            if (hoverReveal) {
                hoverReveal.classList.remove('is-visible');
            }
        });
    });

</script>