</style>

<script>
    const menuBG = document.getElementById('menu-bg') as HTMLDivElement;
    const menuBGFrames = menuBG?.dataset.bgFrames;
    const menuImage = document.getElementById('menu-image');
    let isCursorInside = false;

    if (menuBG && menuBGFrames && menuImage) {
        const bgFrames = JSON.parse(menuBGFrames);
        const preloadedImages: HTMLImageElement[] = [];

        bgFrames.forEach((frame: string, index: number) => {
            const img = new Image() as HTMLImageElement;
            img.src = frame;
            preloadedImages.push(img)
        });

        let currentFrameIndex = 0;
        let resetInterval: number | ReturnType<typeof setInterval>; 
        let menuRect = menuImage.getBoundingClientRect();

        window.addEventListener('resize', (event) => {
            menuRect = menuImage?.getBoundingClientRect();
        })


        function resetFrame(quadrant: number) {
            setInterval(()=> {
                if (quadrant > 1 && menuImage) {
                    menuImage.style.backgroundImage = `url('${preloadedImages[quadrant - 1].src}')`;
                    console.log("Value of quadrant: " + quadrant);
                }
            }, 1000);
        }

        menuImage.addEventListener('mousemove', (event) => {
            if (resetInterval) {
                clearInterval(resetInterval);
            }

            const divStartsAtX = menuRect.left;
            const divEndsAtX = menuRect.right;
            const divWidth = menuRect.width;
            const cursorProgress = Math.max(0, Math.min(event.clientX - divStartsAtX, divEndsAtX));
            currentFrameIndex = Math.floor((cursorProgress / divWidth) * bgFrames.length);

            if (currentFrameIndex >= bgFrames.length) {
                currentFrameIndex = bgFrames.length - 1;
            }

            menuImage.style.backgroundImage = `url('${preloadedImages[currentFrameIndex].src}')`;
            isCursorInside = true;
        });

        menuImage.addEventListener('mouseleave', () => {
            isCursorInside = false;

            if (resetInterval) {
                clearInterval(resetInterval);
            }

            // setTimeout(() => {
                resetInterval = setInterval(() => {

                    if (currentFrameIndex > 0) {
                        currentFrameIndex--;
                        menuImage.style.backgroundImage = `url('${preloadedImages[currentFrameIndex].src}')`;
                    } else {
                        clearInterval(resetInterval);
                    }
                }, 100);
            // }, 1000);
        })
    }

    function updateMenuHeight() {
        const menu = document.getElementById('reveal-menu');
        if (menu) {
            const observer = new ResizeObserver(() => {
                document.documentElement.style.setProperty('--menu-height', `${menu.offsetHeight}px`);
            });
            observer.observe(menu);
        }
    }

    updateMenuHeight();

    const hoverReveal = document.getElementById('hover-reveal') as HTMLDivElement;
    const menuNav = document.querySelector('.menu__nav');
    console.log("Checking...");  
    
    document.addEventListener('mousemove', (event) => {
        hoverReveal.style.top = `${25 + event.clientY}px`;
        hoverReveal.style.left = `${25 + event.clientX}px`;
    });

    menuNav?.querySelectorAll('* > [data-image]').forEach(menuListItem => { 

        menuListItem.addEventListener('mouseenter', () => {
            if (hoverReveal) { hoverReveal.style.backgroundImage = 'url(`${menuListItem.dataset.image}`)'; }

            if (hoverReveal) {
                hoverReveal.style.backgroundImage = `url("${menuListItem.dataset.image}")`;
                hoverReveal.classList.add('is-visible');
            }
        });

        menuListItem.addEventListener('mouseleave', () => {
            if (hoverReveal) {
                hoverReveal.classList.remove('is-visible');
            }
        });
    });

</script>