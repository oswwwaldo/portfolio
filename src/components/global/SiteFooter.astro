---
import Image from 'astro/components/Image.astro';
import Knight from '../../assets/Knight.png';
import KnightASCII from '../../assets/Knight-ASCII.png';

type Props = {

}

const {} = Astro.props

---
<div class="eof">
    <h1> END OF <span></span>.</h1>
</div>

<div class="footer">

    <div class="footer__background">
        <Image 
            class="footer__background__image"
            src={KnightASCII}
            alt="Infinity blade">
        </Image>
    </div>

    <div class="footer__nav">
        <ul class="footer__nav__list">
            <li class="footer__nav__list__item">
                <span class="footer__nav__list__item__index"> 01. </span> 
                <a class="footer__nav__list__item__link"> About </a> 
            </li>
            <li class="footer__nav__list__item">
                <span class="footer__nav__list__item__index"> 01. </span> 
                <a class="footer__nav__list__item__link"> Home </a> 
            </li>
            <li class="footer__nav__list__item">
                <span class="footer__nav__list__item__index"> 01. </span> 
                <a class="footer__nav__list__item__link"> Projects </a> 
            </li>
            <li class="footer__nav__list__item">
                <span class="footer__nav__list__item__index"> 01. </span> 
                <a class="footer__nav__list__item__link"> Contact </a> 
            </li>
        </ul>
    </div>

    <div class="footer__links">
        <div class="footer__links__socials">
            <a class="footer__links__socials__link"> Instagram </a>
            <a class="footer__links__socials__link"> Github </a>
            <a class="footer__links__socials__link"> LinkedIn </a>
            <a class="footer__links__socials__link"> YouTube </a>
        </div>

        <div class="footer__links__content">
            <div class="footer__links__content__nav">
                <div class="info-group">
                    <h4 class="info-group__header">Projects (04)</h4>
                    <p class="info-group__link">Spotify Lyrics Display</p>
                    <p class="info-group__link">Portfolio</p>
                    <p class="info-group__link">New Tab Chess Puzzle</p>
                    <p class="info-group__link">RobCo Industries Terminal</p>
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">Explore</h4>
                    <p class="info-group__link">Start a quest</p>
                    <p class="info-group__link">Sign the guestbook</p>
                    <p class="info-group__link">What am I doing?</p>
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">Other pages</h4>
                    <a class="info-group__link" href="/now">Now</a>
                    <a class="info-group__link" href="/thoughts">Thoughts</a>
                    <a class="info-group__link" href="/video">Video</a>
                    <a class="info-group__link" href="/drop">Drop</a>
                </div>
                <div class="info-group">
                    <h4 class="info-group__header">EN</h4>
                </div>
            </div>
            <div class="footer__links__content__info">
                <div class="footer__links__content__info__flags">
                    <div class="us-flag">
                        <svg width="30" height="15" viewBox="0 0 30 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.04 6.72H30V8.28H13.04V6.72Z" fill="var(--color-flag-red)"/>
                            <path d="M0 10.08H30V11.64H0V10.08Z" fill="var(--color-flag-red)"/>
                            <path d="M0 13.44H30V15H0V13.44Z" fill="var(--color-flag-red)"/>
                            <path d="M13.04 3.36H30V4.92H13.04V3.36Z" fill="var(--color-flag-red)"/>
                            <path d="M13.04 0H30V1.56H13.04V0Z" fill="var(--color-flag-red)"/>
                            <path d="M0 0H11.04V8.28H0V0Z" fill="var(--color-flag-blue)"/>
                        </svg>
                    </div>
                </div>
                <div class="footer__links__content__info__text">
                    <a href="/sitemap"> Sitemap </a>
                    <p> Designed, developed and deployed by </p>
                    <p> Oswaldo Fabrizio De Lo Santos Ascencio </p>
                </div>
            </div>
        </div>
    </div>

</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .footer {
        // display: none !important;
        display: flex;
        flex-direction: column;
        justify-self: space-around;

        color: var(--secondary-color);

        &__background {
            position: relative;

            &__image {
                position: absolute;
                top: -18vh;
                right: 0%;
                // transform: translate(-50%, -50%);

                height: 90vh;
                width: auto;
                object-fit: contain;
                z-index: -1;
            }
        }

        &__nav {
            display: flex;
            flex-direction: column;
            width: 100%;

            margin-bottom: 15vh;

            &__list {
                width: 100%;

                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: flex-start;
                padding: 0px 0px 0px 64px;
                gap: 20px;

                width: 1439px;
                min-height: 350px;

                &__item {
                    display: flex;
                    flex-direction: row;
                    align-items: center;
                    padding: 14px 0px;
                    gap: 24px;

                    width: 1375px;
                    height: 80.8px;

                    width: 100%;
                    border-bottom: var(--border-thin-secondary-20);

                    &__index {
                        display: flex;
                        flex-direction: column;
                        align-items: flex-end;
                        padding: 0px;

                        min-width: 32px;
                        min-height: 24px;

                        font-family: var(--font-heading);
                        font-size: var(--font-size-sm);

                        color: var(--color-secondary-40);
                    }

                    &__link {
                        font-family: var(--font-heading);
                        font-size: var(--font-size-2xl);

                        display: flex;
                        flex-direction: column;
                        align-items: flex-start;

                        min-height: 50px;
                    }
                }
            }
        }

        &__links {
            &__socials {
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: space-around;
                width: 33%;
                margin-bottom: 1rem;

                &__link {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-xs);
                    color: var(--color-secondary-60);
                }
            }

            &__content {
                display: flex;
                flex-direction: row;
                justify-content: space-around;
                border-top: var(--border-thin-secondary-20);
                padding-top: 1rem;

                &__nav {
                    display: flex;
                    flex-direction: row;
                    align-items: flex-start;
                    justify-content: flex-start;

                    padding: 0 2rem;
                    gap: 10vw;

                    min-height: 136px;

                    flex-grow: 1;
                    z-index: 0;

                    .info-group {
                        display: flex;
                        flex-direction: column;
                        align-items: flex-start;
                        gap: 0.5rem;

                        &__header {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            color: var(--secondary-color);
                            letter-spacing: 1.3px;
                        }

                        &__link {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            color: var(--color-secondary-60);
                            letter-spacing: 0.8px;
                        }
                    }
                }

                &__info {
                    display: flex;
                    align-items: flex-start;
                    flex-direction: row-reverse;
                    gap: 2rem;

                    padding: 0 2rem;

                    &__flags {
                        display: flex;
                        flex-direction: column;

                        &__us-flag {
                            fill: var(--color-gray);
                        }
                    }

                    &__text {
                        display: flex;
                        flex-direction: column;
                        
                        a, p {
                            font-family: var(--font-heading);
                            font-size: var(--font-size-xs);
                            text-align: right;
                            color: var(--color-secondary-60);
                        }
                        
                        a {
                            color: var(--color-secondary);
                            text-decoration: none;
                        }

                    }
                }
            }
        }
    }

    .eof {
        display: flex;
        justify-content: end;
        margin: 0 5rem;
        padding: 10vw 4vw;

        h1 {
            font-size: var(--font-size-3xl);
            color: var(--color-secondary-20);

            & span {
                display: inline-grid;
                transition: all 1s ease-in-out;

                &::before, &::after {
                    font-family: var(--font-heading);
                    grid-area: 1/1;
                }
                &::before {
                    content: "PAGE";
                    opacity: 1;
                }
                &::after {
                    content: "FILE";
                    opacity: 0;
                }
                &:hover::before {
                    opacity: 0;
                } 
                &:hover::after {
                    opacity: 1;
                }
            }
        }
    }
</style>