<button 
    class="hamburger" 
    id="hamburger-icon"
    type="button"
    aria-label="Open navigation menu"
    aria-controls="full-menu"
    aria-expanded="false">
        <div class="hamburger__line"></div>
        <div class="hamburger__line"></div>
        <!-- <div class="hamburger__line"></div>
        <div class="hamburger__line"></div> -->
</button>
<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .hamburger {
        background: transparent;
        border: none;
        cursor: pointer;
        width: 100%;

        display: flex;
        align-items: center;
        flex-direction: column;
        cursor: pointer;
        gap: 0.5rem;   

        overflow: hidden;
        transition: 1000ms all ease-in-out;

        &:hover {
            & .hamburger__line {
                &:nth-of-type(1) {
                    translate: 10% 0;
                }
                &:nth-of-type(2) {
                    translate: -10% 0;                        
                }
            }
        }

        .hamburger__line {
            background: var(--secondary-color);
            width: 1.85rem;
            height: 1.10px;

            translate: none; 
            rotate: none; 
            scale: none; 
            transform: translate(0px, 0px);

            translate: 0 0;
            transition: translate 250ms ease-in-out;

            &:nth-of-type(3), &:nth-of-type(4) {
                display: none;
            }
        }
    }

    .is-closing {
        & .hamburger__line {
            &:nth-of-type(1) {
                animation: slideRight 500ms ease-out;
            }

            &:nth-of-type(2) {
                animation: slideLeft 500ms ease-out;
            }
        }
    }

    // .is-active 

    @keyframes slideLeft {
        from {
            translate: 0 0;
        }

        49% {
            translate:-125% 0;
            opacity: 1;
        }

        50% {
            translate: 125% 0;
            opacity: 0;
        }

        51% {
            translate: 125% 0;
            opacity: 1;
        }

        to {
            translate: 0 0;
        }
    }

    @keyframes slideRight {
        from {
            translate: 0 0;
        }

        49% {
            translate: 125% 0;
            opacity: 1;
        }

        50% {
            translate: -125% 0;
            opacity: 0;
        }

        51% {
            translate: -125% 0;
            opacity: 1;
        }

        to {
            translate: 0 0;
        }
    }

</style>
<script>
    const hamburger = document.getElementById('hamburger-icon') as HTMLDivElement;

    hamburger.addEventListener('click', () => {
        hamburger.classList.add('is-closing');
        
        setTimeout(() => {
            hamburger.classList.remove('is-closing');
        }, 500); 
    });
</script>