---
import Menu from '../global/Menu.astro';
import ThemeIcon from '../ui/ThemeIcon.astro';
import Watermark from '../ui/Watermark.astro';
import Hamburger from './Hamburger.astro';
---

<div class="wrapper" id="nav-wrapper">
    <div class="nav-wrapper" id="navbar">
        <div class="nav-logo">
            <a class="nav-logo__title label" id="site-name" href="/"> oswwwaldo </a>
        </div>
        <Watermark class="nav-watermark" />
        <nav class="nav-links">
            <a class="nav-links__link label" href="/about"> About </a>
            <a class="nav-links__link label" href="/"> Home </a>
            <a class="nav-links__link label" href="/projects"> Projects </a>
            <a class="nav-links__link label" href="/contact"> Contact </a>
            <div class="nav-links__theme">
                <ThemeIcon size={20}></ThemeIcon>
            </div>
            <Hamburger />
        </nav>
    </div>
</div>

<Menu />

<style lang="scss">
@use '../../styles/variables.scss' as *;

    .wrapper {

        &.is-sticky {
            position: sticky;
            top: 0;
            height: 0;
            overflow: visible;
            z-index: var(--nav-layer);

            & .nav-wrapper {
                position: sticky !important;
                background: var(--primary-color);
                border: 1px solid var(--color-secondary-05);

                &:hover {  
                    border: 1px solid var(--color-secondary-20);
                }
            }
        }
    }

    .nav-logo__watermark {
        display: none;
    }

    a {
        color: var(--secondary-color);
        font-family: var(--font-heading);
        letter-spacing: 5.2px;
        text-decoration: none;
        transition: font-weight 0.2s ease;
        &:hover {   
            font-weight: bold;
        }
    }

    .nav-wrapper {
        position: absolute;
        top: 0; left: 0;
        z-index: var(--nav-layer);

        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 2rem;
        width: 100%;
        box-sizing: border-box;     
        border: 1px solid transparent;

        &:hover {
            border: 1px solid var(--color-secondary-05);
        }
        
        &--alt {
            padding: 1rem 2rem 3.5rem;
            border-bottom: 1px solid var(--secondary-color);
            min-height: 90px;
        }

        &--no-pad {
            padding: 0 2rem;
        }
    }

    .nav-watermark {
        display: none;
    }

    .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center; 

        &__link {
            display: flex;
            align-items: center;
        }
    }

    @media (max-width: 768px) {

        .wrapper {
            position: absolute;
            top: 10%;
        }
        .nav-wrapper {
            background-color: var(--primary-color);
            justify-content: space-between;

            position: sticky;
            top: 0;
        }

        .nav-links {
            &__link {
                display: none !important; 
            }

            &__theme {
                display: none;
            }

            &__hamburger {
                display: flex; 
                align-items: center;
                justify-content: center;
            }
        }
    }

    @media (max-width: 425px) {
        .nav-wrapper {
            flex-direction: row;
            padding: 1rem;

            & .nav-logo {
                display: none;
            }
        }
    }

    :global(.is-open) {
        clip-path: polygon(0 100%, 100% 100%, 100% 0, 0 0) !important;
        
        @media (prefers-reduced-motion: reduce) {
            display: flex !important;
        }
        
        @media (prefers-reduced-motion: no-preference) {
            .menu {
                clip-path: polygon(0 100%, 100% 100%, 100% 0, 0 0) !important;
            }
        }
    }

    :global(.is-closed) {
        clip-path: polygon(0 0, 100% 0, 100% 0, 0 0) !important;

        @media (prefers-reduced-motion: reduce) {
            display: none !important;
        }

        @media (prefers-reduced-motion: no-preference) {
            .menu {
                clip-path: polygon(0 0, 100% 0, 100% 0, 0 0) !important;
            }
        }
    }

    .wrapper.is-hidden {
        position: sticky;
        top: 0;
        z-index: var(--max-layer);
    }

    .nav-wrapper.is-hidden {
        border: 1px solid var(--color-secondary-05);
        position: sticky;

        .nav-logo {
            visibility: hidden; 
        }

        .nav-watermark {
            display: flex;
        }

        .nav-links {
            .nav-links__link {
                visibility: hidden !important;
            }
        }        
    }
</style>
<script>
    const navWrapper = document.getElementById('nav-wrapper');
    const navbar = document.getElementById('navbar');
    const hamburger = document.getElementById('hamburger-icon');
    const menu = document.getElementById('full-menu');
    const siteName = document.getElementById('site-name');

    function trackTime() {
        const today = new Date();
        const formattedDate = today.toISOString().split('T')[0];
        const orientation = new Date('2026-08-20');
        const firstday = new Date('2026-09-22');
        const diffInMs = Math.abs(Number(orientation) - Number(today));
        const tilMarcyOrientation = Math.ceil((Math.abs(Number(orientation) - Number(today))) / (1000 * 60 * 60 * 24)); 
        const tilMarcyFirstDay = Math.ceil(Math.abs(Number(firstday) - Number(today)) / (1000 * 60 * 60 * 24)); 
        console.log(`${formattedDate}`)
        console.log(`${tilMarcyOrientation} days left until orientation day at Marcy Lab.`);
        console.log(`${tilMarcyFirstDay} days left until the fellowship at Marcy Lab begins.`);
        
        if (siteName) {
            siteName.textContent = `oswwwaldo — ${tilMarcyOrientation} days left`;
            siteName.title = `And there are ${tilMarcyFirstDay} until Marcy.`;
        }
    }

    function toggleMenu() {        
        const isOpen = menu?.classList.toggle('is-open') ?? menu?.classList.toggle('is-closed');
        hamburger?.classList.toggle('is-active');
        navbar?.classList.toggle('is-hidden');
        navWrapper?.classList.toggle('is-hidden');

        hamburger?.setAttribute('aria-expanded', String(isOpen));
        hamburger?.setAttribute(
            'aria-label',
            isOpen ? 'Close navigation menu' : 'Open navigation menu',
        );
    }

    hamburger?.addEventListener('click', () => {
        console.log('Mobile menu click event fired');  
        toggleMenu();
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            console.log('Escape key pressed!');
            toggleMenu();
        }
    });

    document.addEventListener('DOMContentLoaded', (event) => {
        console.log('The DOM is fully loaded and parsed.');
        trackTime();
    });
</script>