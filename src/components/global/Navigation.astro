---
import Icon from '../ui/AppIcon.astro';
import ThemeIcon from '../ui/ThemeIcon.astro';
---

<div class="nav-wrapper">
    <div class="nav-logo">
        <a class="nav-logo__title label" href="/"> oswwwaldo </a>
    </div>
    <nav class="nav-links">
        <a class="nav-links__link label" href="/about"> About </a>
        <a class="nav-links__link label" href="/"> Home </a>
        <a class="nav-links__link label" href="/projects"> Projects </a>
        <a class="nav-links__link label" href="/contact"> Contact </a>
        <div class="nav-links__theme">
            <ThemeIcon size={20}></ThemeIcon>
        </div>
        <button class="nav-links__hamburger">
            <Icon name="mynaui:menu"></Icon>
        </button>
    </nav>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    a {
        color: var(--secondary-color);
        font-family: var(--font-heading);
        letter-spacing: 5.2px;
        text-decoration: none;
        transition: font-weight 0.2s ease;
        &:hover {   
            font-weight: bold;
        }
    }

    .nav-wrapper {
        position: absolute;
        top: 0; 
        left: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        z-index: 999;
        padding: 1rem 2rem;
        box-sizing: border-box; 
    }

    .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center; 

        &__link {
            display: flex;
            align-items: center;
        }

        &__hamburger {
            background: transparent;
            border: none;
            cursor: pointer;

            svg {
                color: var(--secondary-color);
                width: 24px;
                height: 24px;
            }
        }
    }

    @media (max-width: 768px) {
        .nav-logo {
            
        }

        .nav-wrapper {
            background-color: var(--primary-color);
            justify-content: space-between;

            position: sticky;
            top: 0;
        }

        .nav-links {
            &__link {
                display: none !important; 
            }

            &__theme {
                display: none;
            }

            &__hamburger {
                display: flex; 
                align-items: center;
                justify-content: center;
            }
        }
    }

    @media (max-width: 425px) {
        .nav-wrapper {
            flex-direction: row;
            padding: 1rem;

            & .nav-logo {
                display: none;
            }
        }
    }
</style>
<script>
    const hamburger = document.querySelector('.nav-links__hamburger');

    hamburger?.addEventListener('click', () => {
        console.log('mobile menu click event fired');
    })
</script>