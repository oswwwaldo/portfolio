---

import Icon from '../ui/AppIcon.astro';
import type { HTMLAttributes } from 'astro/types';

type ButtonType = "button" | "submit" | "reset";

interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
  textContent: string;
  type?: ButtonType;
  icon?: string;
}

const {textContent, type = "button", icon = null, ...rest } = Astro.props;

const rawUuid = crypto.randomUUID();
const elementId = `btn-id-${rawUuid}`;

---``

<button id={elementId} type={type}>
    <p> {textContent}</p>
    {icon && (
        <span class="button__icon">
            <Icon name={icon}></Icon>
        </span>
    )}
</button>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    button {
        background-color: var(--primary-color);
        border: 1px solid var(--secondary-color);
        color: var(--secondary-color);

        // transition: all 300ms ease-in;

        padding: 1rem 2rem;

        width: 250px;
        height: 90px;

        &:hover {
            background-color: var(--secondary-color);
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
        }
    }
</style> 
<script>

</script>