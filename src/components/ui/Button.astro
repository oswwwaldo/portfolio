---
import Icon from "../ui/AppIcon.astro";
import type { HTMLAttributes } from "astro/types";

type ButtonType = "button" | "submit" | "reset";

interface Props extends Omit<HTMLAttributes<"button">, "type"> {
  textContent: string;
  type?: ButtonType;
  icon?: string;
  isPrimary?: boolean;
}

const {
  textContent,
  type = "button",
  icon = null,
  isPrimary = false,
  class: className,
  ...rest
} = Astro.props;

const rawUuid = crypto.randomUUID();
const elementId = `btn-id-${rawUuid}`;
---

<button
  id={elementId}
  type={type}
  class:list={["button", className, { invert: isPrimary }]}
  {...rest}
>
  <span class="button__text">{textContent}</span>
  {
    icon && (
      <span class="button__icon">
        <Icon name={icon} />
      </span>
    )
  }
</button>

<style lang="scss">
  @use "../../styles/variables.scss" as *;

  .button { 
        // --button-height: var(--hero-button-height, clamp(2.5rem, 3vw, 5rem));

        background-color: var(--primary-color);
        border: var(--border-thin-secondary);
        color: var(--secondary-color);

        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(0.5rem, 0.8vw, 0.875rem);
        box-sizing: border-box;

        block-size: var(--button-height);
        aspect-ratio: var(--button-aspect-ratio);
        padding: clamp(1.5rem, 1.8vw, 1.75rem);;

        line-height: 1;
        white-space: nowrap;

        width: 200px;
        max-height: 72px;

        cursor: pointer;
        transition: opacity 0.3s ease;

        &:hover {
            opacity: 60%;
        }

        &.invert {
            background-color: var(--secondary-color);
            border: var(--border-thin-primary);
            color: var(--primary-color);
        }
        
        &__text {
            margin: 0;
            line-height: 1;

            font-family: var(--font-heading);
            font-size: var(--font-size-base);
        }

        &__icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-sm);
            line-height: 0;
        }
    }

  @media (max-width: 770px) {
    .button {
      height: clamp(3rem, 6vw, 4rem);
      padding: clamp(1.25rem, 3vw, 1.75rem);
      gap: clamp(0.5rem, 1vw, 0.75rem);
      font-size: var(--font-size-sm);
    }
  }
</style>
