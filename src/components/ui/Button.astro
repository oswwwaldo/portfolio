---

interface Props {
    textContent: string;
    href?: string;
    inverted?: boolean;
}

const {textContent, href, inverted = false } = Astro.props;

const rawUuid = crypto.randomUUID();
const elementId = `btn-id-${rawUuid}`;

---

<button id={elementId}>
    {textContent}
</button>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    button {
        background-color: var(--secondary-color);
        border: 1px solid var(--primary-color);
        color: var(--primary-color);

        padding: 1rem 2rem;
    }
</style> 
<script>

</script>