---

import Tag from '../ui/Tag.astro';

type BaseProps = {
    itemTitle: string;
    itemDescription: string;
    itemTimeline: string;
    itemSkills: string[]; 
};

type JobProps = BaseProps & {
    itemType: "Job";
    itemCaption: string;
    itemIndex?: number;
};

type ProjectProps = BaseProps & {
    itemType: "Project";
    itemCaption?: string;
    itemIndex: number;
};

type Props = JobProps | ProjectProps;

const { 
    itemType, 
    itemIndex,
    itemTitle, 
    itemCaption, 
    itemDescription, 
    itemTimeline, 
    itemSkills 
} = Astro.props;
---
{
    itemType == "Job" ? 
        <div class="job">
            <div class="job__date"> 
                {itemTimeline}
            </div>
            <div class="job__position">
                <div class="job__position__title"> 
                    <h3> 
                        {itemTitle}
                    </h3>
                </div>
                <div class="job__position__company"> 
                    {itemCaption} 
                </div>
                <div class="job__position__description"> 
                    {itemDescription}
                </div>
            </div>
            <div class="job__skills">
                { 
                    itemSkills.map((skill) => (
                        <Tag textContent={skill} />
                    ))
                }
            </div>
        </div>
    :

    <div class="project">
        <div class="project__index">  
            <span> { itemIndex.toString().padStart(2, '0')} </span>
        </div>
        <div class="project__info">
            <div class="project__info__title"> 
                <h3> 
                    {itemTitle}
                </h3>
            </div>
            <div class="project__info__description"> 
                {itemDescription}
            </div>
            <div class="project__info__skills">
                { 
                    itemSkills.map((skill) => (
                        <Tag textContent={skill} />
                    ))
                }
            </div>
        </div>
        <div class="project__date">
            <p class="project__date__text"> {itemTimeline} </p>
        </div>
    </div>

}

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    :root {
        --level-aboreto-heading-offset: 0.25rem;
    }

    .job:first-of-type {
        border-top: var(--border-thin-secondary);
    }
    .job {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        box-sizing: border-box;
        padding: 40px 0;

        border-bottom: var(--border-thin-secondary);
        min-height: 100px;
        height: auto;
        max-height: 300px;
        width: 100%;
        gap: 2vw;

        display: grid;
        align-items: end;
        grid-auto-flow: row;
        grid-template-columns: 1fr 3fr 1fr;
        background-color: var(--primary-color);

        &__date {
            display: flex;
            flex-direction: row;
            align-items: flex-start;
            height: 100%;
            padding-top: var(--level-aboreto-heading-offset);
        }

        &__position {
            display: flex;
            align-items: flex-start;
            flex-direction: column;
            gap: 1rem;
            height: 100%;
            padding: 0 1.75rem;

            &__company {
                font-family: var(--font-body);
                font-size: var(--font-size-base);
            }
            &__description {
                font-family: var(--font-body);
                font-size: var(--font-size-sm);
            }
        }

        &__skills {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: flex-start;
            align-content: flex-start;
            gap: 0.5rem;
            height: 100%;
            padding-top: var(--level-aboreto-heading-offset);
        }
    }

    @media (max-width: 425px) {
        .job {
            padding: 20px 0;
            gap: 1vw;

            &__date {
                font-size: var(--font-size-sm);
                margin-bottom: 1rem;
                color: var(--color-secondary-60);
            }

            &__position {
                gap: 1rem;
            }
        }
    }

    @media (max-width: 1024px) {
        .job {
            flex-direction: column;
            max-height: none;

            &__position {
                width: 100%;
            }

            &__skills {
                width: 100%;
                max-width: fit-content;
            }
        }
    }

    .project {
        display: grid;
        grid-template-columns: 80px 1fr 80px;
        width: 100%;
        padding: 40px 24px 96px 16px;
        border-bottom: var(--border-thin-secondary);

        @media (max-width: 768px) {
            grid-template-columns: 1fr;
            gap: 3rem;
            padding: 32px 16px 64px;
        }

        &__index {
            font-family: var(--font-heading);
            font-size: var(--font-size-xs);
            letter-spacing: 4.4px;
            padding-top: 16px; 
        }

        &__info {
            display: flex;
            flex-direction: column;
            gap: 24px;

            &__title {
                font-family: var(--font-heading);
                font-size: var(--font-size-lg);
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            &__description {
                font-family: var(--font-body);
                font-size: var(--font-size-base);
                max-width: 625px;
            }

            &__skills {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                margin-top: 24px;
            }
        }

        &__date {
            display: flex;
            justify-content: end;

            @media (max-width: 768px) {
                justify-content: start;
            }

            &__text {
                font-family: var(--font-body);
                font-size: var(--font-size-xs);
                letter-spacing: 4.08px;
            }
        }
    }

</style>