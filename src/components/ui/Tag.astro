---
type Props = {
    textContent: string;
    target?: string;
}

const { textContent, target } = Astro.props

---
<div class="tag">
    <a class="label" href={target}> {textContent} </a>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .tag {
        display: flex;
        align-items: center;
        flex-direction: row;
        justify-content: center;
        padding: clamp(0.1rem, 0.5rem + 1vw, 0.2rem) clamp(0.2rem, 0.5rem + 1vw, 0.8rem);

        
        // aspect-ratio: 5/1;  
        border: var(--tag-border);
        background: var(--primary-color);
        
        a {
            font-family: var(--font-heading);
            font-size: var(--font-size-xs);
            color: var(--tag-text);
            letter-spacing: 0.10vw;
        }
    }

</style>