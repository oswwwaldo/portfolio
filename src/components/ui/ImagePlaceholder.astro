---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  src: ImageMetadata;
  alt: string;
}
const { src, alt, ...props } = Astro.props;
---

<div class="image-placeholder">
  <Image 
    src={src} 
    alt={alt} 
    {...props} 
  />
</div>

<style lang="scss">
  @use '../../styles/variables.scss' as *;

  .image-placeholder {
    position: relative;
    overflow: hidden;
    background-color: var(--color-overlay-black-100); 
    transition: background-color 50ms ease-in;

    &:hover {
      background-color: var(--color-overlay-black-60);
    }
  }
</style>