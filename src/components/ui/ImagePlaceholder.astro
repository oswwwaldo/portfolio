---
import { Image } from 'astro:assets';

// interface Props {
//     src: string;
//     alt: string;
//     // onload?: any;
// }
const { src, alt, ...props } = Astro.props;
---

<div class="image-placeholder animate-pulse">
  <Image 
    src={src} 
    alt={alt} 
    onload="this.parentElement.classList.remove('animate-pulse')" 
    {...props} 
  />
</div>

<style>
  .image-placeholder {
    position: relative;
    background-color: rgb(#D9D9D9 / 0.2); 
    overflow: hidden;
  }
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .5; }
  }
</style>