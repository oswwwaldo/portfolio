---
type Props = {
    type: string;
    items: string[];
}

const {type, items} = Astro.props
---
<div class="detail">
    <h3 class="detail__header">
        {type}
    </h3>
    <ul class="detail__list">
        {
            items.map((item) => (
                <li class="detail__list__item">
                    <span class="detail__list__item__span">
                        {item}
                    </span>
                </li>
            ))
        }
    </ul>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .detail {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        align-self: flex-start;
        padding: 48px 40px;
        gap: 32px;
        margin: 0 auto;
        width: 50%;

        &__header {
            color: var(--secondary-color);
        }

        &__list {
            display: flex;
            flex-direction: column;
            gap: 3rem;
            width: 100%;

            &__item {
                container-type: inline-size;
                width: 100%;
                padding: 1rem 1rem 1rem 0.50rem;

                border-bottom: var(--border-thin-secondary);
                font-family: var(--font-body);
                font-size: var(--font-size-sm);
                transition: background-color 200ms ease-in-out, color 200ms ease-in-out;

                white-space: nowrap;      
                overflow: hidden;        
                text-overflow: ellipsis;

                &:hover {
                    background-color: var(--secondary-color);
                    color: var(--primary-color);
                }
            }
        }

    }

    @media (max-width: 1024px) {
        .detail {
            width: 100%;
        }
    }
    
    @media (max-width: 425px) {
        .detail {
            padding: 48px 16px;
        }
    }
</style>