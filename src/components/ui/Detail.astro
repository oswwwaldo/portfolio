---
type Props = {
    type: string;
    items: string[];
}

const {type, items} = Astro.props
---
<div class="detail">
    <h4 class="detail__header">
        {type}
    </h4>
    <ul class="detail__list">
        {
            items.map((item) => (
                <li class="detail__list__item">
                    <span class="detail__list__item__span">
                        {item}
                    </span>
                </li>
            ))
        }
    </ul>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .detail {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        align-self: flex-start;
        padding: 48px 40px;
        gap: 32px;
        margin: 0 auto;
        width: 50%;

        &__header {
            font-family: var(--font-heading);
            font-size: 24px;
            color: var(--secondary-color);
        }

        &__list {
            display: flex;
            flex-direction: column;
            gap: 3rem;
            width: 100%;

            &__item {
                container-type: inline-size;
                width: 100%;
                padding: 1rem 1rem 1rem 0.50rem;

                border-bottom: 1px solid var(--secondary-color);
                font-family: var(--font-body);
                font-size: 1rem;
                transition: background-color 200ms ease-in-out, color 200ms ease-in-out;

                white-space: nowrap;      
                overflow: hidden;        
                text-overflow: ellipsis;


                span {
                    display: inline-block;
                    padding-right: 0.5rem;
                    animation: hoverOutScroll 1.5s ease-in forwards;
                }

                &:hover {
                    background-color: var(--secondary-color);
                    color: var(--primary-color);
                    text-overflow: clip;

                    &.--is-scrollable span {
                        animation: hoverInScroll 1.5s ease-in-out forwards;
                    }
                }
            }
        }

    }

    /* 
       We calculate the exact difference between the container's width (100cqi) 
       minus the horizontal padding (1.5rem), and the span's total width (100%).
       min(0px, ...) ensures that if the text is shorter than the container, 
       it resolves to 0px and doesn't scroll at all!
    */

    @keyframes hoverInScroll {
        0%, 15% {
            transform: translateX(0);
        }
        85%, 100% {
            transform: translateX(min(0px, calc(100cqi - 1.7rem - 100%)));
        }
    }

    @keyframes hoverOutScroll {
        0%, 15% {
            transform: translateX((min(0px, calc(100cqi - 1.7rem - 100%))));
        }
        85%, 100% {
            transform: translateX(0);
        }
    }   
</style>
<script>
    const checkOverflow = () => {
        const detailListItems = document.querySelectorAll('.detail__list__item');

        detailListItems.forEach((item) => {
            if (item.scrollWidth > item.clientWidth) {
                item.classList.add('--is-scrollable');
            } else {
                item.classList.remove('--is-scrollable');
            }
        });
    };

    checkOverflow();

    window.addEventListener('resize', checkOverflow);

</script>