<style lang="scss">
  @use '../../styles/variables.scss' as *;
        
            
    .lines {
        display: flex;
        flex-direction: row;
        justify-content: space-evenly;
        width: 100%;

        position: absolute;
        top: 0; left: 50%;

        transform: translateX(-50%);
        pointer-events: none;
    
        &__line {
            background: var(--secondary-color);
            width: 1px;
            height: 100vh;
        }
    }

    @media screen and (max-width: 768px) {
        .lines__line:first-of-type, .lines__line:last-of-type {
            display: none;
        }
    }
    
</style>