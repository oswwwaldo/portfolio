---
export interface Props {
  isEntirePage?: boolean;
}

const { isEntirePage = false } = Astro.props;
---

<div class:list={['lines', { 'lines--full-page': isEntirePage }]}>
    <div class="lines__line"></div>
    <div class="lines__line"></div>
    <div class="lines__line"></div>
    <div class="lines__line"></div>
    <div class="lines__line"></div>
</div>
    
<style lang="scss">
  @use '../../styles/variables.scss' as *;
        
            
    .lines {
        display: flex;
        flex-direction: row;
        justify-content: space-evenly;
        width: 100%;

        position: absolute;
        top: 0; left: 50%;

        transform: translateX(-50%);
        pointer-events: none;

        opacity: var(--decor-opacity);
        
        &--full-page {
            height: stretch;
            height: 100%;
            bottom: 0;

            z-index: var(--decor-layer);
        }
    
        &__line {
            background: var(--secondary-color);
            width: 1px;
            height: stretch;
        }
    }

    @media screen and (max-width: 768px) {
        .lines__line:first-of-type, .lines__line:last-of-type {
            display: none;
        }
    }
    
</style>