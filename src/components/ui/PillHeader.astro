            gap: clamp(0.5rem, 3vw, 2.5rem);
        }

        &__image {
            display: inline-block;
            vertical-align: middle;
            width: clamp(120px, 20vw, 252px);
            height: clamp(36px, 6vw, 74px);
            background: var(--color-neutral-200);
