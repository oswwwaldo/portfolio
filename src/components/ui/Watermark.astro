---
const { class: className, ...rest } = Astro.props;
---

<div class:list={['watermark', className]} {...rest}>
    <p class="watermark__text" title="hello there"> Oswaldo Fabrizio De Los Santos Ascencio </p>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;
    
    .watermark {
        display: flex;
        justify-content: center;
        z-index: 999;
        pointer-events: none;
        position: absolute;
        top: 30%;

        z-index: var(--watermark-layer);
        width: 100%;

        &__text {
            font-family: var(--font-heading);
            font-size: var(--font-size-sm);
            letter-spacing: 5px;
            color: var(--secondary-color);
            text-align: center;

            position: relative;
            pointer-events: all;

            &::after {
                content: '';
                display: none;
                position: absolute;
                top: 120%;
                left: 50%;
            }

            &:hover {
                &::after {
                    content: ".";
                    color: white;
                    display: flex;

                }
            }
        }
    }
</style>
<script>
    const watermark = document.querySelector('watermark') as HTMLDivElement;

</script>