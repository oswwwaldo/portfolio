---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import Tag from '../../components/ui/Tag.astro';

interface Props {
    project: CollectionEntry<'projects'>
}

const { project } = Astro.props
---
<div class="card">
    <div class="card__image">
        <Image src={project.data.thumbnail.cover} alt={project.data.thumbnail.coverAlt} />
    </div>
    <div class="card__title">
        <h3> {project.data.title} </h3>
    </div>
    <div class="card__description">
        <p> {project.data.caption} </p>
    </div>
    <div class="card__tags">
        {project.data.technologies.map((technology: string)=> {
            return <Tag textContent={technology} />
        })}
    </div>
</div>
<style lang="scss">
    .card {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        
        width: 100%; 
        aspect-ratio: 4;
        margin: 0 auto; 

        &:hover {
            // background-color: var(--color-secondary-05);
        }

        &__image {
            // margin-bottom: 1rem;
            filter: brightness(0.08);
            width: 100%;
                        
            :global(img), :global(svg) { 
                width: 100%;
                height: auto;

                aspect-ratio: 7/5;
                display: block;
                object-fit: cover;
            }
        }

        &__tags {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
    }

    @media (max-width: 768px) {
        .card {
            // gap: 2.5vh; 
            gap: 1rem;
        }
    }
</style>