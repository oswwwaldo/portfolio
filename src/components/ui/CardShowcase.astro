---
import ImagePlaceholder from '../../components/ui/ImagePlaceholder.astro';
import thumbnail from '../../assets/media/thumbnail.png';
import Tag from '../../components/ui/Tag.astro';
---
<div class="card">
    <div class="card__image">
        <ImagePlaceholder 
            src={thumbnail}
            alt="placeholder-image" 
        />
    </div>
    <div class="card__title">
        <h3> New Tab Chess </h3>
    </div>
    <div class="card__description">
        <p> Abstract data visualization dashboard for modern enterprise analytics </p>
    </div>

    <div class="card__tags">
        <Tag textContent = 'A/B Testing'></Tag>
        <Tag textContent = 'User Research'></Tag>
        <Tag textContent = 'Prototyping'></Tag>
        <Tag textContent = 'Wireframing'></Tag>
    </div>
</div>

<style lang="scss">
    .card {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        
        width: 100%; 
        aspect-ratio: 4;
        margin: 0 auto; 

        &:hover {
            // background-color: var(--color-secondary-05);
        }

        &__image {
            // margin-bottom: 1rem;
            width: 100%;
                        
            :global(img), :global(svg) { 
                width: 100%;
                height: auto;

                aspect-ratio: 7/5;
                display: block;
                object-fit: cover;
            }
        }

        &__tags {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
    }

    @media (max-width: 768px) {
        .card {
            // gap: 2.5vh; 
            gap: 1rem;
        }
    }
</style>