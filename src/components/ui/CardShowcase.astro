---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import Tag from '../../components/ui/Tag.astro';

interface Props {
    project: CollectionEntry<'projects'>
}

const { project } = Astro.props
---
<div class="card">
    <div class="card__image">
        <Image class="card__image__img" src={project.data.thumbnail.cover} alt={project.data.thumbnail.coverAlt} />
    </div>
    <div class="card__title">
        <h3> 
            <a href={`/projects/${project.id}`}>
                {project.data.title} 
            </a>
        </h3>
        <div class="card__title__icon">
            <svg width="24" height="25" viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                <line x1="-4.37114e-08" y1="0.5" x2="24" y2="0.499998" stroke="white"/>
                <line x1="23.5" y1="25" x2="23.5" y2="1" stroke="white"/>
                <line x1="0.646447" y1="23.6464" x2="23.6464" y2="0.646446" stroke="white"/>
            </svg>
        </div>
    </div>
    <div class="card__description">
        <p> {project.data.caption} </p>
    </div>
    <div class="card__tags">
        {project.data.technologies.map((technology: string)=> {
            return <Tag textContent={technology} />
        })}
    </div>
</div>
<style lang="scss">
    .card {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        
        width: 100%; 
        aspect-ratio: 4;
        margin: 0 auto; 
        transition: translate 0.3s ease;
        cursor: pointer;

        position: relative;

        &:hover {
            .card__image {
                filter: brightness(0.10);

                & img {
                    transform: scale(1.10);
                }
            }
        }

        &__image {
            filter: brightness(0.08);
            width: 100%;
            overflow: hidden;
            transition: filter 0.3s ease;
                        
            :global(img), :global(svg) { 
                width: 100%;
                height: auto;
                aspect-ratio: 7/5;
                display: block;
                object-fit: cover;
            }
        }

        &__title {
            display: flex;
            flex-direction: row nowrap;
            justify-content: space-between;

            a {
                font-family: inherit;
                font-size: inherit;
                color: inherit;
                text-decoration: none;

                &::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                }
            }

            &__icon {
                svg {
                    fill: var(--secondary-color);
                    transition: translate 0.3s ease; 
                    
                    .card:hover & {
                        translate: 5px -5px;
                    }
                }
            }
        }

        &__tags {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
    }

    @media (max-width: 768px) {
        .card {
            gap: 1rem;
        }
    }
</style>