---
import { Image } from 'astro:assets';

interface Props {
    src: ImageMetadata;
    alt: string;
    class?: string;
    scale?: number;
    duration?: number;
}

const { src, alt, class: className, scale = 1.1, duration = 0.4 } = Astro.props;
---

<div 
    class:list={["landing-image", className]} 
    id="image-track"
    data-scale={scale}
    data-mouse-down-at="0"  
    data-prev-percentage="0"
>
    <!-- First image acts as the GSAP target and the trigger -->
    <Image src={src} alt={alt} class="photo" draggable="false" />
    
    <!-- Track images hidden by default -->
    <Image src={src} alt={alt} class="track-photo" draggable="false" />
    <Image src={src} alt={alt} class="track-photo" draggable="false" />
    <Image src={src} alt={alt} class="track-photo" draggable="false" />
    <Image src={src} alt={alt} class="track-photo" draggable="false" />
    <Image src={src} alt={alt} class="track-photo" draggable="false" />
    <Image src={src} alt={alt} class="track-photo" draggable="false" />
    <Image src={src} alt={alt} class="track-photo" draggable="false" />
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .landing-image {
        position: absolute;
        top: 30%;
        left: 70%;
        transform: translate3d(-50%, -50%, 0);
        width: min(70%, 50rem);
        height: auto;
        aspect-ratio: 2 / 1;
        z-index: -1;
        
        overflow: hidden;
        -webkit-mask-image: -webkit-radial-gradient(white, black);
        
        /* Smooth transition for the container when switching modes */
        transition: top 0.8s ease, left 0.8s ease, width 0.8s ease;
        user-select: none;

        .photo {
            width: 100%;
            height: 100%;
            max-width: none;
            object-fit: cover;
            cursor: pointer;
            
            backface-visibility: hidden; 
            transform: translateZ(0); 
            will-change: transform;
            transition: width 0.8s ease, height 0.8s ease;
        }

        .track-photo {
            display: none; /* Hidden until clicked */
            width: 40vmin;
            height: 56vmin;
            object-fit: cover;
            object-position: 100% center;
            opacity: 0; 
        }

        &::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1; 
            box-shadow: inset 0 0 0 1000px rgba(0, 0, 0, 0.0);
            transition: box-shadow 0.3s ease;
        }

        :global(.dark) &::before { 
            box-shadow: inset 0 0 0 1000px rgba(0, 0, 0, 0.8); 
        } 
        
        &:hover:not(.is-expanded) {
            &::before { box-shadow: inset 0 0 0 1000px rgba(0, 0, 0, 0.05); }
            :global(.dark) &::before { box-shadow: inset 0 0 0 1000px rgba(0, 0, 0, 0.6); }
        }

        /* --- THE EXPANDED TRACK STATE --- */
        &.is-expanded {
            top: 50%;
            left: 50%;
            width: auto;
            aspect-ratio: auto;
            display: flex;
            gap: 4vmin;
            
            /* Disable the masking and clipping to reveal the track */
            overflow: visible;
            -webkit-mask-image: none;
            
            &::before {
                display: none; /* Removes the dark hover shadow overlay */
            }

            .photo {
                width: 40vmin;
                height: 56vmin;
                cursor: grab;
                object-position: 100% center;
            }

            .track-photo {
                display: block;
                animation: revealTrack 0.8s ease forwards;
            }
        }
    }

    @keyframes revealTrack {
        from { opacity: 0; transform: translateX(20px); }
        to { opacity: 1; transform: translateX(0); }
    }

    @media (max-width: 770px){
        .landing-image:not(.is-expanded) {
            width: min(80vw, 32rem);
            left: 50%;
            top: 30%;
        }
    }
</style>

<script>
    import { gsap } from "gsap"; 

    const initImageInteraction = () => {
        const track = document.getElementById("image-track") as HTMLElement | null;
        if (!track) return;
        
        const photo = track.querySelector('.photo') as HTMLElement | null;
        if (!photo) return;

        const scale = parseFloat(track.getAttribute('data-scale') || '1.1');
        let isExpanded = false;

        /* --- 1. GSAP Hover Logic --- */
        const onHover = (event: Event) => {
            if (isExpanded) return; // Prevent GSAP firing if track is open
            gsap.to(photo, {
                duration: scale,
                ease: 'power4.out',
                scale: event.type === 'mouseover' ? scale : 1,
            });
        };

        const onMove = (event: MouseEvent) => {
            if (isExpanded) return;
            const rect = track.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;

            const xPercent = (x / rect.width) * 100;
            const yPercent = (y / rect.height) * 100;

            gsap.set(photo, {
                transformOrigin: `${xPercent}% ${yPercent}%`,
            });
        };

        track.addEventListener('mouseover', onHover);
        track.addEventListener('mouseout', onHover);
        track.addEventListener('mousemove', onMove as EventListener);

        /* --- 2. The Switch (Click to Expand) --- */
        const expandTrack = () => {
            if (isExpanded) return;
            isExpanded = true;
            
            // Kill GSAP listeners to prevent interference
            track.removeEventListener('mouseover', onHover);
            track.removeEventListener('mouseout', onHover);
            track.removeEventListener('mousemove', onMove as EventListener);
            
            // Normalize the photo back to scale 1
            gsap.to(photo, {
                scale: 1,
                duration: 0.5,
                ease: 'power2.out',
                clearProps: "transformOrigin"
            });

            // Trigger CSS state change
            track.classList.add('is-expanded');
            track.dataset.percentage = "0";
            track.dataset.prevPercentage = "0";
        };

        photo.addEventListener('click', expandTrack);

        /* --- 3. Drag Carousel Logic --- */
        const handleOnDown = (clientX: number) => {
            if (!isExpanded) return;
            track.dataset.mouseDownAt = clientX.toString();
        };

        const handleOnUp = () => {
            if (!isExpanded) return;
            track.dataset.mouseDownAt = "0";
            track.dataset.prevPercentage = track.dataset.percentage || "0";
        };

        const handleOnMoveDrag = (clientX: number) => {
            if (!isExpanded) return;
            if (track.dataset.mouseDownAt === "0" || !track.dataset.mouseDownAt) return;

            const mouseDownAt = parseFloat(track.dataset.mouseDownAt);
            const mouseDelta = mouseDownAt - clientX;
            const maxDelta = window.innerWidth / 2;

            const percentage = (mouseDelta / maxDelta) * -100;
            const prevPercentage = parseFloat(track.dataset.prevPercentage || "0");
            
            const nextPercentageUnconstrained = prevPercentage + percentage;
            const nextPercentage = Math.max(Math.min(nextPercentageUnconstrained, 0), -100);

            track.dataset.percentage = nextPercentage.toString();
            
            track.animate({
                transform: `translate(calc(-50% + ${nextPercentage}%), -50%)`
            }, { duration: 1200, fill: "forwards" });

            // Apply parallax object-position to all images (both .photo and .track-photo)
            const allImages = track.querySelectorAll('.photo, .track-photo');
            for (const img of allImages) {
                img.animate({
                    objectPosition: `${100 + nextPercentage}% center`
                }, { duration: 1200, fill: "forwards" });
            }
        };

        // Bind Drag Events using Type-Safe Listeners
        window.addEventListener('mousedown', (e: MouseEvent) => handleOnDown(e.clientX));
        window.addEventListener('touchstart', (e: TouchEvent) => handleOnDown(e.touches[0].clientX));
        
        window.addEventListener('mouseup', handleOnUp);
        window.addEventListener('touchend', handleOnUp);
        
        window.addEventListener('mousemove', (e: MouseEvent) => handleOnMoveDrag(e.clientX));
        window.addEventListener('touchmove', (e: TouchEvent) => handleOnMoveDrag(e.touches[0].clientX));
    };

    initImageInteraction();
    // document.addEventListener('astro:page-load', initImageInteraction);
</script>