        //     height: 150px;
        //     background-color: var(--secondary-color);
        // }

        &:hover {
            &::before {
                // background-color: red;
            }
        }
        
        h1 {
            font-size: var(--font-size-2xl);
        }

        .second-line {
            display: block; 
            font-family: inherit;
            font-size: inherit;
        }
    }

    @media (max-width: 768px) {
        .section-header h1 {
            margin-right: 1rem;
        }

        .section-header .second-line {
            display: inline; 
