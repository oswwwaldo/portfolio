---
interface Props {
    textContent: string;
    secondLine?: string;
}

const { textContent, secondLine } = Astro.props;
---

<div class="section-header">
    <h1>
        {textContent}
        {secondLine && (
            <>
                <br />
                {secondLine}
            </>
        )}
    </h1>
</div>

<style lang="scss">
    .section-header {
        margin-bottom: 1rem;
    }
</style>