---
interface Props {
    textContent: string;
    secondLine?: string;
}

const { textContent, secondLine } = Astro.props;
---

<div class="section-header">
    <h1>
        {textContent}
        {secondLine && (
            <span class="second-line">{' '}{secondLine}</span>
        )}
    </h1>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .section-header {
        position: relative;
        margin-bottom: 1rem;

        // &::before {
        //     content: "";
