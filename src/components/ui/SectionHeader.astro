---
interface Props {
    textContent: string;
    secondLine?: string;
}

const { textContent, secondLine } = Astro.props;
---

<div class="section-header">
    <h1>
        {textContent}
        {secondLine && (
            <>
                <br />
                {secondLine}
            </>
        )}
    </h1>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .section-header {
        margin-bottom: 1rem;
        
        h1 {
            font-size: var(--font-size-2xl);
        }
    }
</style>