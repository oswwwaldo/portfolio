---
interface Props {
    textContent: string;
    isFullWidth?: boolean;
}

const { textContent, isFullWidth = false } = Astro.props;
---

<div class:list={['section-header', { 'section-header--full-width': isFullWidth }]}>
    <h1>
        {textContent}
    </h1>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .section-header {
        display: flex;
        margin-bottom: 1rem;    
        width: 50%;
        
        h1 {
            font-size: var(--font-size-2xl);
        }

        &--full-width {
            width: 100%;
        }

        .second-line {
            display: block; 
            font-family: inherit;
            font-size: inherit;
        }
    }

    @media (max-width: 768px) {
        .section-header {
            width: 100%;
        }
        .section-header h1 {
            margin-right: 1rem;
        }
    }
</style>