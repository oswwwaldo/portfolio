---
interface Props {
    top?: number;
    left?: number;
    rotate?: number;
}

const { top = 0, left = 0, rotate = 0 } = Astro.props;
---

<div
    class="lines"
    style={`top: ${top}%; left: ${left}%; transform: rotate(${rotate}deg);`}
>
    <div class="lines__line"></div>
    <div class="lines__line"></div>
    <div class="lines__line"></div>
</div>

<style lang="scss">
    @use "../../styles/variables.scss" as *;

    .lines {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-evenly;
        width: 20%;

        position: absolute;
        top: 0;
        left: 70%;

        pointer-events: none;

        width: 10%;
        // top: -35%; left: 60%;
        // rotate: 130deg;

        z-index: var(--decor-layer);
        opacity: var(--decor-opacity);

        &__line {
            background: var(--secondary-color);
            width: 1px;
            height: 100vh;

            &:nth-child(2):nth-last-child(2) {
                height: 140vh;
            }
        }
    }
</style>
