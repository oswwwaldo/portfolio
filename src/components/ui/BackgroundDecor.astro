---
import GridLines from '../ui/GridLines.astro';
import DiagonalLines from '../ui/DiagonalLines.astro';
import Ellipse from '../ui/Ellipse.astro';

import SideRays from '../ui/SideRays.astro';
const sideRays: boolean = true;
const stretchFull: boolean = true;

/* Randomize the position of DiagonalLines on an axis, and Ellipse */
---

{sideRays && 
    <SideRays
        speed={2.5}
        rayColor1="#EAB308"
        rayColor2="#96c8ff"
        intensity={2}
        spread={2}
        origin="top-right"
        tilt={0}
        saturation={1.5}
        blend={0.75}
        falloff={1.6}
        opacity={1}
    />
}
<div class="decor">
    <GridLines />
    <DiagonalLines />
    <Ellipse />
    <div style={{ width: '100%', height: '600px', position: 'relative' }}>
    </div>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .decor {
        opacity: 5% !important;
        height: auto;
    }

</style>