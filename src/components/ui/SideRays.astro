---
export interface Props {
  speed?: number;
  rayColor1?: string;
  rayColor2?: string;
  intensity?: number;
  spread?: number;
  origin?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  tilt?: number;
  saturation?: number;
  blend?: number;
  falloff?: number;
  opacity?: number;
  class?: string;
}

const {
  speed = 2.5,
  rayColor1 = '#EAB308',
  rayColor2 = '#96c8ff',
  intensity = 2,
  spread = 2,
  origin = 'top-right',
  tilt = 0,
  saturation = 1.5,
  blend = 0.75,
  falloff = 1.6,
  opacity = 1.0,
  class: className = ''
} = Astro.props;
---

<side-rays
  class={`side-rays-container ${className}`.trim()}
  data-speed={speed}
  data-raycolor1={rayColor1}
  data-raycolor2={rayColor2}
  data-intensity={intensity}
  data-spread={spread}
  data-origin={origin}
  data-tilt={tilt}
  data-saturation={saturation}
  data-blend={blend}
  data-falloff={falloff}
  data-opacity={opacity}
>
</side-rays>

<script>
  import { Renderer, Program, Triangle, Mesh } from 'ogl';

  const hexToRgb = (hex: string) => {
    const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return m ? [parseInt(m[1], 16) / 255, parseInt(m[2], 16) / 255, parseInt(m[3], 16) / 255] : [1, 1, 1];
  };

  const originToFlip = (origin: string) => {
    switch (origin) {
      case 'top-left': return [1, 0];
      case 'bottom-right': return [0, 1];
      case 'bottom-left': return [1, 1];
      default: return [0, 0];
    }
  };

  class SideRaysElement extends HTMLElement {
    private isVisible = false;
    private renderer: any = null;
    private animationId: number | null = null;
    private observer: IntersectionObserver | null = null;
    private resizeObserver: ResizeObserver | null = null;
    private uniforms: any = null;
    private updateSizeCallback: (() => void) | null = null;

    static get observedAttributes() {
      return [
        'data-speed', 'data-raycolor1', 'data-raycolor2',
        'data-intensity', 'data-spread', 'data-origin',
        'data-tilt', 'data-saturation', 'data-blend',
        'data-falloff', 'data-opacity'
      ];
    }

    connectedCallback() {
      this.observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          this.isVisible = entry.isIntersecting;

          if (this.isVisible && !this.renderer) {
            this.initializeWebGL();
          }
        },
        { threshold: 0.1 }
      );

      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.cleanup();
    }

    attributeChangedCallback(name: string, oldValue: string, newValue: string) {
      if (!this.uniforms || oldValue === newValue) return;

      switch (name) {
        case 'data-speed': this.uniforms.iSpeed.value = parseFloat(newValue); break;
        case 'data-raycolor1': this.uniforms.iRayColor1.value = hexToRgb(newValue); break;
        case 'data-raycolor2': this.uniforms.iRayColor2.value = hexToRgb(newValue); break;
        case 'data-intensity': this.uniforms.iIntensity.value = parseFloat(newValue); break;
        case 'data-spread': this.uniforms.iSpread.value = parseFloat(newValue); break;
        case 'data-origin': {
          const [flipX, flipY] = originToFlip(newValue);
          this.uniforms.iFlipX.value = flipX;
          this.uniforms.iFlipY.value = flipY;
          break;
        }
        case 'data-tilt': this.uniforms.iTilt.value = parseFloat(newValue); break;
        case 'data-saturation': this.uniforms.iSaturation.value = parseFloat(newValue); break;
        case 'data-blend': this.uniforms.iBlend.value = parseFloat(newValue); break;
        case 'data-falloff': this.uniforms.iFalloff.value = parseFloat(newValue); break;
        case 'data-opacity': this.uniforms.iOpacity.value = parseFloat(newValue); break;
      }
    }

    async initializeWebGL() {
      await new Promise(resolve => setTimeout(resolve, 10));
      if (!this.isConnected) return;

      const renderer = new Renderer({
        dpr: Math.min(window.devicePixelRatio, 2),
        alpha: true
      });
      this.renderer = renderer;

      const gl = renderer.gl;
      gl.canvas.style.width = '100%';
      gl.canvas.style.height = '100%';

      this.innerHTML = '';
      this.appendChild(gl.canvas);

      const vert = `
        attribute vec2 position;
        void main() {
          gl_Position = vec4(position, 0.0, 1.0);
        }`;

      const frag = `precision highp float;

        uniform float iTime;
        uniform vec2 iResolution;
        uniform float iSpeed;
        uniform vec3 iRayColor1;
        uniform vec3 iRayColor2;
        uniform float iIntensity;
        uniform float iSpread;
        uniform float iFlipX;
        uniform float iFlipY;
        uniform float iTilt;
        uniform float iSaturation;
        uniform float iBlend;
        uniform float iFalloff;
        uniform float iOpacity;

        float rayStrength(vec2 raySource, vec2 rayRefDirection, vec2 coord, float seedA, float seedB, float speed) {
          vec2 sourceToCoord = coord - raySource;
          float cosAngle = dot(normalize(sourceToCoord), rayRefDirection);

          float distanceFalloff = clamp((1.25 - length(sourceToCoord)) / 1.25, 0.5, 1.0);

          return clamp(
            (0.45 + 0.15 * sin(cosAngle * seedA + iTime * speed)) +
            (0.3 + 0.2 * cos(-cosAngle * seedB + iTime * speed)),
            0.0, 1.0) *
            distanceFalloff;
        }

        void main() {
          vec2 fragCoord = gl_FragCoord.xy;
          if (iFlipX > 0.5) fragCoord.x = iResolution.x - fragCoord.x;
          if (iFlipY > 0.5) fragCoord.y = iResolution.y - fragCoord.y;

          float referenceWidth = max(iResolution.x, 1.0);

          // Width-based coordinate space keeps the rays' shape stable while height changes.
          vec2 coord = vec2(
            fragCoord.x / referenceWidth,
            (iResolution.y - fragCoord.y) / referenceWidth
          );

          // Decouple ray origin from viewport height so extending the canvas reveals more of the rays.
          vec2 rayPos = vec2(1.1, -0.5);

          float tiltRad = iTilt * 3.14159265 / 180.0;
          float cs = cos(tiltRad);
          float sn = sin(tiltRad);
          vec2 rel = coord - rayPos;
          vec2 tiltedCoord = vec2(rel.x * cs - rel.y * sn, rel.x * sn + rel.y * cs) + rayPos;

          float halfSpread = iSpread * 0.275;
          vec2 rayRefDir1 = normalize(vec2(cos(0.785398 + halfSpread), sin(0.785398 + halfSpread)));
          vec2 rayRefDir2 = normalize(vec2(cos(0.785398 - halfSpread), sin(0.785398 - halfSpread)));

          vec4 rays1 = vec4(iRayColor1, 1.0) * rayStrength(rayPos, rayRefDir1, tiltedCoord, 36.2214, 21.11349, iSpeed);
          vec4 rays2 = vec4(iRayColor2, 1.0) * rayStrength(rayPos, rayRefDir2, tiltedCoord, 22.3991, 18.0234, iSpeed * 0.2);

          vec4 color = rays1 * (1.0 - iBlend) * 0.9 + rays2 * iBlend * 0.9;

          float distanceToLight = length(coord - rayPos);
          float brightness = iIntensity * 0.4 / pow(max(distanceToLight, 0.001), iFalloff);
          color.rgb *= brightness;

          float gray = dot(color.rgb, vec3(0.299, 0.587, 0.114));
          color.rgb = mix(vec3(gray), color.rgb, iSaturation);

          color.a = max(color.r, max(color.g, color.b)) * iOpacity;
          gl_FragColor = color;
        }`;

      const [flipX, flipY] = originToFlip(this.dataset.origin || 'top-right');

      this.uniforms = {
        iTime: { value: 0 },
        iResolution: { value: [1, 1] },
        iSpeed: { value: parseFloat(this.dataset.speed || '2.5') },
        iRayColor1: { value: hexToRgb(this.dataset.raycolor1 || '#EAB308') },
        iRayColor2: { value: hexToRgb(this.dataset.raycolor2 || '#96c8ff') },
        iIntensity: { value: parseFloat(this.dataset.intensity || '2') },
        iSpread: { value: parseFloat(this.dataset.spread || '2') },
        iFlipX: { value: flipX },
        iFlipY: { value: flipY },
        iTilt: { value: parseFloat(this.dataset.tilt || '0') },
        iSaturation: { value: parseFloat(this.dataset.saturation || '1.5') },
        iBlend: { value: parseFloat(this.dataset.blend || '0.75') },
        iFalloff: { value: parseFloat(this.dataset.falloff || '1.6') },
        iOpacity: { value: parseFloat(this.dataset.opacity || '1.0') }
      };

      const geometry = new Triangle(gl);
      const program = new Program(gl, { vertex: vert, fragment: frag, uniforms: this.uniforms });
      const mesh = new Mesh(gl, { geometry, program });

      this.updateSizeCallback = () => {
        if (!this.isConnected || !this.renderer || !this.uniforms) return;

        const w = Math.max(1, this.clientWidth);
        const h = Math.max(1, this.clientHeight);

        this.renderer.dpr = Math.min(window.devicePixelRatio, 2);
        this.renderer.setSize(w, h);
        this.uniforms.iResolution.value = [w * this.renderer.dpr, h * this.renderer.dpr];
      };

      this.resizeObserver = new ResizeObserver(() => {
        this.updateSizeCallback?.();
      });
      this.resizeObserver.observe(this);

      window.addEventListener('resize', this.updateSizeCallback);
      this.updateSizeCallback();

      const loop = (t: number) => {
        if (!this.renderer || !this.uniforms) return;

        if (this.isVisible) {
          this.uniforms.iTime.value = t * 0.001;
          try {
            this.renderer.render({ scene: mesh });
          } catch {
            return;
          }
        }

        this.animationId = requestAnimationFrame(loop);
      };

      this.animationId = requestAnimationFrame(loop);
    }

    cleanup() {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
        this.animationId = null;
      }

      if (this.updateSizeCallback) {
        window.removeEventListener('resize', this.updateSizeCallback);
      }

      if (this.resizeObserver) {
        this.resizeObserver.disconnect();
        this.resizeObserver = null;
      }

      if (this.observer) {
        this.observer.disconnect();
        this.observer = null;
      }

      if (this.renderer) {
        try {
          const loseCtx = this.renderer.gl.getExtension('WEBGL_lose_context');
          if (loseCtx) loseCtx.loseContext();

          const canvas = this.renderer.gl.canvas;
          if (canvas && canvas.parentNode) canvas.parentNode.removeChild(canvas);
        } catch {
          // no-op
        }
      }

      this.renderer = null;
      this.uniforms = null;
      this.updateSizeCallback = null;
    }
  }

  customElements.define('side-rays', SideRaysElement);
</script>

<style>
  side-rays {
    display: block;
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 100%;
    transform: translateX(-50%);
    z-index: 999;
    opacity: 100% !important;
  }

  .side-rays-container {
    display: block;
  }

  :global(.dark) .side-rays-container {
    display: none;
  }
</style>