---
interface Props {
    stat: string;
    caption: string;
}

const { stat, caption } = Astro.props;
---

<div class="stats__item">
    <h2 class="stats__item__num"> {stat} </h2>
    <p class="stats__item__description"> {caption} </p>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .stats__item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 30px;

        width: 180px;
        row-gap: 2em;
        
        &__num {
            width: 180px;
            height: 56px;

            font-family: var(--font-heading);
            font-size: 3rem;
        }
        &__description {
            font-family: var(--font-heading);
            font-size: 1rem;
            letter-spacing: 0.2em;
            color: rgb(from var(--secondary-color) rgb / 0.8);
        }
    }


</style>