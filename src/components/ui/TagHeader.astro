---
interface Props {
    title: string;
    sum: number;
}

const { title, sum } = Astro.props;
---

<div class="tag-header">
    <h1 class="tag-header__text"> {title} </h1> 
    <p class="tag-header__number"> {sum} </p>
</div>

<style lang="scss">
    .tag-header {
        display: flex;
        flex-direction: row;
        align-self: flex-start;
        justify-content: center;
        gap: 1rem;

        height: 112px;

        font-family: var(--font-heading);
        color: var(--secondary-color);

        &__text {
            height: 100%;

            &:hover {
                opacity: 80%;
            }
        }
        &__number {
            height: min-content;
        }
    }
</style>