---
import { Image } from 'astro:assets';

import signature from '../../assets/signature.png';
---


<div class="signature">
    <!-- <Image class="signature__img" src={signature} alt="Oswaldo De Los Santos"></Image> -->
    <div class="signature__domain">
        <p> oswwwaldo.dev </p>
    </div>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .signature {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        &__img {
            filter: invert(1);

            width: 20%;
            display: none;
        }

        &__domain {
            & p {
                color: var(--secondary-color);
            }
        }
    }

</style>