---
import CardShowcase from '../ui/CardShowcase.astro';
import SectionHeader from '../ui/SectionHeader.astro';
---
<section class="selected-works">
    <SectionHeader textContent="Selected" secondLine="Works"/>
    <div class="selected-works__cards">
        <CardShowcase />
        <CardShowcase />    
    </div>
</section>

<style lang="scss">
    @use '../../styles/variables.scss' as *;  
    
    .selected-works {
        display: flex;
        flex-direction: column;
        color: var(--secondary-color);  

        &__cards {
            display: flex;
            flex-direction: row;
            gap: 5vw;

            width: 100%;
        }
    }

    @media (max-width: 768px){
        .selected-works {
            margin-right: 3vw;
        }
    }

    @media (max-width: 600px){
        .selected-works__cards {
            flex-direction: column;
        }
    }

    @media (max-width: 768px){
        .selected-works__cards {
            gap: 3rem;
        }
    }

</style>