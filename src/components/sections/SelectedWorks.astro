---
import { getCollection } from 'astro:content';
import CardShowcase from '../ui/CardShowcase.astro';
import SectionHeader from '../ui/SectionHeader.astro';

const projects = await getCollection('projects')
const MAX_FEATURED = 2;

const featuredProjects = projects
    .filter(project => project.data.featured)
    .slice(0, MAX_FEATURED);

console.log('Selected works project number: ' + featuredProjects.length);
---
<section class="selected-works" id="selected-works">
    <SectionHeader textContent="Selected works"/>
    <div class="selected-works__cards">
        {featuredProjects.map(project=> {
            if (project.data.featured) {
                return <CardShowcase project={project} />
            }
        })}
    </div>
</section>

<style lang="scss">
    @use '../../styles/variables.scss' as *;  
    
    .selected-works {
        display: flex;
        flex-direction: column;
        color: var(--secondary-color);  

        &__cards {
            display: flex;
            flex-direction: row;
            gap: 5vw;

            width: 100%;
        }
    }

    @media (max-width: 768px){
        .selected-works {
            margin-right: 3vw;
        }
    }

    @media (max-width: 600px){
        .selected-works__cards {
            flex-direction: column;
        }
    }

    @media (max-width: 768px){
        .selected-works__cards {
            gap: 3rem;
        }
    }

</style>