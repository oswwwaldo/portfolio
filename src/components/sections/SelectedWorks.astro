---
import CardShowcase from '../ui/CardShowcase.astro'
type Props = {

}

const {} = Astro.props

---
<section class="selected-works">
    <div class="selected-works__header">
        <h1> Selected <br> Works </h1>
    </div>
    <div class="selected-works__cards">
        <CardShowcase />
        <CardShowcase />    
    </div>
</section>

<style lang="scss">
    @use '../../styles/variables.scss' as *;  
    
    .selected-works {
        display: flex;
        flex-direction: column;

        color: var(--secondary-color);  

        &__header {
            // width: 50%;
            margin-bottom: 1rem;
            
        }

        &__cards {
            display: flex;
            flex-direction: row;
            // justify-content: space-between;
            gap: 5vw;

            width: 100%;
        }
    }

    @media (max-width: 770px){
        .selected-works__cards {
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 10vh;
        }
    }

</style>