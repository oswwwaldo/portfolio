---
import { Image } from "astro:assets";
import SectionHeader from "../ui/SectionHeader.astro"
import portrait from '../../assets/media/whele.jpg';
---

<div class="about">
    <!-- <SectionHeader textContent="About me" /> -->
    <d  iv class="about__wrapper">
        <div class="about__portrait">
            <Image class="about__portrait__img" src={portrait} alt="A portrait of me" />
        </div>
        <div class="about__content">
            <SectionHeader textContent="About me" isFullWidth={true}/>
            <p> I'm a full-stack software engineer based in New York City with a passion for building products that
                sit at the intersection of engineering precision and thoughtful design. I specialize in creating 
                scalable web applications — from low-level system architecture to polished, pixel-perfect interfaces.
            </p>
        </div>
    </d>
    <div class="about__footer">
        <div class="about__footer__item">
            <div class="about__footer__item__header"> Email </div>
            <div class="about__footer__item__content"> ofdelossantosa@gmail.com </div>
        </div>

        <div class="about__footer__item">
            <div class="about__footer__item__header"> LinkedIn </div>
            <div class="about__footer__item__content"> linkedin.com/oswwwaldo </div>
        </div>

        <div class="about__footer__item">
            <div class="about__footer__item__pill"></div>
        </div>
    </div>
</div>
<style lang="scss">
    @use '../../styles/variables.scss' as *;
    
    .about {
        // background: rgb(37, 37, 37);
        display: flex;
        flex-direction: column;
        color: var(--secondary-color);
        gap: 1rem;

        &__wrapper {
            display: flex;
            align-items: end;
            flex-direction: row;
            gap: 4rem;
            width: 100%;
            height: 100%;

            margin-top: 1rem;
            margin-bottom: 2rem;
        }

        &__portrait {
            display: flex;
            align-self: baseline;
            flex-grow: 1;

            &__img {

                aspect-ratio: 1;
                width: 100%;
                height: auto;
            }
        }

        &__content {
            display: flex;
            flex-direction: column;
            flex-shrink: 2;
            gap: 2rem;
        }

        &__footer {
            display: flex;
            display: none !important;
            flex-flow: row wrap;
            justify-content: flex-start;
            gap: 5rem;
            width: 100%;

            border-top: var(--border-thin-secondary-100);
            padding-top: 2rem;

            &__item {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                
                &__header {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-base);
                    color: var(--color-secondary-80);
                }
                &__content {
                    font-family: var(--font-body);
                    font-size: var(--font-size-base);
                    color: var(--secondary-color);
                }
                &__pill {
                    display: block;
                    background: var(--secondary-color);
                    width: 25vw;
                    height: 100%;
                    // aspect-ratio: 2/1;
                }
            }

        }
    }

</style>