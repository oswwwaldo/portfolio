---
import TagHeader from "../ui/TagHeader.astro";

interface Props {
    text: string[];
}

const { text } = Astro.props;
---

<div class="tag-cloud">
    {
        text.map((word) => (
            <TagHeader title={word} sum={49} />
        ))
    }
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;
    .tag-cloud {
        display: flex;
        flex-wrap: wrap;
    }

    .vertical {
        flex-direction: column;
    }
</style>

