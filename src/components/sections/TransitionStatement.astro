---
type Props = {

}

const {} = Astro.props

---
<div class="transition">
    <div class="statement">
        <h2> Full-stack engineer fluent in modern ecosystems with two years of experience. </h2>
    </div>
    <div class="orbit">
        <p class="body-lg"> Come take a look at my portfolio and get to know me, either through my work or via my about me! </p>
        <div class="orbit__planets">
            <div class="orbit__planets__planet"><a> About me </a></div>
            <div class="orbit__planets__planet"><a> Projects </a></div>
        </div>
    </div>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .transition {
        display: flex;
        align-items: start;
        justify-content: space-evenly;

        color: var(--secondary-color);
    }

    .statement {
        flex-grow: 2;
    }

    .orbit {
        display: flex;
        flex-direction: column;
        &__planets {
            position: relative;
            width: 100%;
            height: 100%;
            &__planet {
                display: flex;
                align-items: center;
                justify-content: center;

                aspect-ratio: 1;
                border-radius: 100%;
                background-color: rgb(from var(--secondary-color) r g b / 0.1);

                &:first-child {
                    min-height: 100px;
                    max-height: 300px;
                }

                &:last-child {
                    height: 35%;
                    position: absolute;
                    top: -25%; right: 20%;
                }
            }
        }
    }

</style>