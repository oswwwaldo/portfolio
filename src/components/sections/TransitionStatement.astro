---
type Props = {

}

const {} = Astro.props

---
<div class="transition">
    <div class="statement">
        <h2> 
            <span>Full-stack engineer fluent in </span> 
            <span class="statement__emphasis">modern ecosystems </span>
            <span>with </span> 
            <span class="statement__emphasis">two years of experience. </span>
        </h2>
    </div>
    <div class="orbit"> 
        <p> Come take a look at my portfolio and get to know me, either through my work or via my about me! </p>
        <div class="orbit__planets">
            <div class="orbit__planets__planet"><a> About me </a></div>
            <div class="orbit__planets__planet"><a> Projects </a></div>
        </div>
    </div>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .transition {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 5.5rem;
        color: var(--secondary-color);
        
        .statement {
            h2 {
                span {
                    display: inline;
                    font-family: inherit;
                    font-size: inherit;
                }
                
                .statement__emphasis {
                    font-family: var(--font-heading);
                    font-size: inherit;
                    background: var(--highlight-color);

                    &:hover {
                        background: var(--highlight-hover-color);
                    }
                }
            }

            @media (max-width: 1200px) {
                margin-bottom: 5vh;
            }
        }

        .orbit {
            display: flex;
            flex-direction: column;
            width: 450px;
            gap: 4rem;
            height: auto;

            &__planets {
                position: relative;
                width: 100%;
                height: 100%;
                
                &__planet {
                    display: flex;
                    align-items: center;
                    justify-content: center;

                    aspect-ratio: 1;
                    border-radius: 100%;
                    background-color: var(--color-secondary-40);

                    &:first-child {
                        height: clamp(100px, 10rem, 180px);
                    }

                    &:last-child {
                        height: clamp(75px, 5vw, 150px); 
                        position: absolute;
                        top: -30%; right: -20%;
                    }
                }
            }
            @media (max-width: 1200px) {
                display: none;
            }
        }
    }
</style>