---
import SectionHeader from '../ui/SectionHeader.astro';

import ListItem from '../ui/ListItem.astro';
import Detail from '../ui/Detail.astro';
import StatsItem from '../ui/StatsItem.astro';
import Tag from '../ui/Tag.astro';
---

<div class="work-experience">
    <SectionHeader textContent="Work" secondLine="Experience"/>
    <div class="work-experience__history">
        <ListItem 
            itemType = "Job"
            itemTitle = "Software Engineer"
            itemCaption = "Marcy Lab School"
            itemDescription = "Spearheaded the technical web roadmap and front-end optimization for an award-winning mental health nonprofit."
            itemTimeline = "2017 — 2027"
            itemSkills = {["React", "Express.js", "Next.js", "PostgreSQL", "Postman"]};
        />  
        <ListItem 
            itemType = "Job"
            itemTitle = "Frontend Techincal Lead"
            itemCaption = "Nunchi Health"
            itemDescription = "Spearheaded the technical web roadmap and front-end optimization for an award-winning mental health nonprofit."
            itemTimeline = "2017 — 2027"
            itemSkills = {["JavaScript", "AppsScript", "A/B Testing", "Astro.js"]};
        />
        <ListItem 
            itemType = "Job"
            itemTitle = "Software Engineer Intern"
            itemCaption = "Cognizant"
            itemDescription = "Spearheaded the technical web roadmap and front-end optimization for an award-winning mental health nonprofit."
            itemTimeline = "2017 — 2027"
            itemSkills = {["React", "JavaScript", "Django", "SQL", "SCSS", "HTML", "Python"]};
        />
    </div>
    <div class="work-experience__info">
        <Detail 
            type="Certifications" 
            items={["AWS Developer - Associate", "MongoDB Associate Developer"]};>
        </Detail>

        <Detail 
            type="Education"
            items={["City College of New York - Computer Science (B.S)", "Borough of Manhattan Community College - Computer (A.S)"]};>
        </Detail>
    </div>
    <div class="work-experience__stats">
        <StatsItem stat="6+" caption="Years of experience" />
        <StatsItem stat="5+" caption="Hackathons won" />
        <StatsItem stat="$120k+" caption="Revenue generated" />
        <StatsItem stat="12+" caption="Deployed projects" />
    </div>
    <div class="work-experience__tech">
        <h4> TECH STACK </h4>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
    </div>
    <div class="list-footer">
        <div class="list-footer__item">
            <div class="list-footer__item__header"> Based In </div>
            <div class="list-footer__item__content"> New York, NY </div>
        </div>

        <div class="list-footer__item">
            <div class="list-footer__item__header"> Github </div>
            <div class="list-footer__item__content"> github.com/oswwwaldo </div>
        </div>

        <div class="list-footer__item">
            <div class="list-footer__item__header"> LinkedIn </div>
            <div class="list-footer__item__content"> linkedin.com/in/oswwwaldo/ </div>
        </div>
    </div>

</div>
<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .work-experience {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5vw;

        margin-top: 10vh;

        color: var(--secondary-color);

        &__history {
            display: flex;
            flex-direction: column;
            align-items: start;

            .job {
                display: flex;
                flex-direction: row;
                justify-content: space-between;
                align-items: flex-start;
                box-sizing: border-box;

                padding: 40px 30px;
                gap: 10px;

                border-bottom: 1px solid black;
                min-height: 100px;
                width: 100%;

                &__date {
                    display: flex;
                    flex-direction: row;
                    align-items: flex-start;
                    height: 100%;
                }

                &__position {
                    display: flex;
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 1rem;

                    // // margin: 0 auto;
                    // width: 486px;
                    // height: 112px;
                    height: 100%;
                    width: fit-content;

 
                    &__title {
                        min-height: 40px;

                        font-family: var(--font-heading);
                        font-size: var(--fs-32);
                    }

                    &__company {
                        min-height: 20px;

                        font-family: var(--font-body);
                        font-size: var(--fs-24);
                    }
                    &__description {
                        min-height: 35px;

                        font-family: var(--font-body);
                        font-size: var(--fs-16);
                    }
                }

                &__skills {
                    display: flex;
                    flex-direction: row;
                    flex-wrap: wrap;
                    align-items: flex-start;
                    align-content: flex-start;
                    gap: 10px;

                    max-width: 150px;
                    height: 100%;


                    /* Inside auto layout */
                    flex: none;
                    order: 2;
                    align-self: stretch;
                    flex-grow: 0;

                }
            }
        }

        &__info {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 32px;
            width: 100%;

        }

        &__tech {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: flex-start;
            align-content: flex-start;
            gap: 15px;

            h4 {
                width: 100%;
                margin: 1   .5rem 0;
            }
        }

        &__stats {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            align-content: center;

            width: 100%;
            min-height: 120px;
        }

        &__footer {

        }
    }

    .list-footer {
        display: flex;
        flex-direction: row;
        gap: 8rem;
        width: 100%;

        &__item {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            
            &__header {
                font-family: var(--font-heading);
                font-size: var(--fs-24);
                color: rgb(from var(--secondary-color) rgba / 0.8);
            }
            &__content {
                font-family: var(--font-body);
                font-size: var(--fs-24);
                color: var(--secondary-color);
            }
        }
    }

</style>
