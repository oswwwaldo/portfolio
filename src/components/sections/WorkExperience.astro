---
import SectionHeader from '../ui/SectionHeader.astro';

import ListItem from '../ui/ListItem.astro';
import Detail from '../ui/Detail.astro';
import StatsItem from '../ui/StatsItem.astro';
import Tag from '../ui/Tag.astro';
---

<div class="work-experience">
    <SectionHeader textContent="Work" secondLine="Experience"/>
    <div class="work-experience__history">
        <ListItem 
            itemType = "Job"
            itemTitle = "Software Engineer"
            itemCaption = "Marcy Lab School"
            itemDescription = "Spearheaded the technical web roadmap and front-end optimization for an award-winning mental health nonprofit."
            itemTimeline = "2017 — 2027"
            itemSkills = {["React", "Express.js", "Next.js", "PostgreSQL", "Postman"]};
        />  
        <ListItem 
            itemType = "Job"
            itemTitle = "Frontend Techincal Lead"
            itemCaption = "Nunchi Health"
            itemDescription = "Spearheaded the technical web roadmap and front-end optimization for an award-winning mental health nonprofit."
            itemTimeline = "2017 — 2027"
            itemSkills = {["JavaScript", "AppsScript", "A/B Testing", "Astro.js"]};
        />
        <ListItem 
            itemType = "Job"
            itemTitle = "Software Engineer Intern"
            itemCaption = "Cognizant"
            itemDescription = "Spearheaded the technical web roadmap and front-end optimization for an award-winning mental health nonprofit."
            itemTimeline = "2017 — 2027"
            itemSkills = {["React", "JavaScript", "Django", "SQL", "SCSS", "HTML", "Python"]};
        />
    </div>
    <div class="work-experience__info">
        <Detail 
            type="Certifications" 
            items={["AWS Developer - Associate", "MongoDB Associate Developer"]};>
        </Detail>

        <Detail 
            type="Education"
            items={["City College of New York - Computer Science (B.S)", "Borough of Manhattan Community College - Computer (A.S)"]};>
        </Detail>
    </div>
    <div class="work-experience__stats">
        <StatsItem stat="6+" caption="Years of experience" />
        <StatsItem stat="5+" caption="Hackathons won" />
        <StatsItem stat="$120k+" caption="Revenue generated" />
        <StatsItem stat="12+" caption="Deployed projects" />
    </div>
    <div class="work-experience__tech">
        <h4> TECH STACK </h4>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
        <Tag textContent="PHP"/>
    </div>
    <div class="work-experience__footer">
        <div class="work-experience__footer__item">
            <div class="work-experience__footer__item__header"> Based In </div>
            <div class="work-experience__footer__item__content"> New York, NY </div>
        </div>

        <div class="work-experience__footer__item">
            <div class="work-experience__footer__item__header"> GitHub </div>
            <div class="work-experience__footer__item__content"> github.com/oswwwaldo </div>
        </div>
    </div>

</div>
<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .work-experience {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5vh;

        margin-top: 10vh;

        color: var(--secondary-color);

        &__history {
            display: flex;
            flex-direction: column;
            align-items: start;
            // margin: 5vh 0;
        }

        &__info {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 32px;
            width: 100%;

            margin: 5vh 0;
        }

        &__tech {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: flex-start;
            align-content: flex-start;
            gap: 1rem;

            padding: 4rem 0;
            border-top: var(--border-thin-secondary);  
            border-bottom: var(--border-thin-secondary); 

            h4 {
                width: 100%;
                margin: 1rem 0;
                font-size: var(--font-size-md);
            }
        }

        &__stats {
            display: grid;
            width: 100%;

            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            align-items: start;

            @media (max-width: 770px) { 
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem; /* Slightly smaller gap for mobile */
            }

        }

        &__footer {
            display: flex;
            flex-direction: row;
            justify-content: flex-start;
            gap: 5rem;
            width: 100%;

            &__item {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                
                &__header {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-base);
                    color: var(--color-secondary-80);
                }
                &__content {
                    font-family: var(--font-body);
                    font-size: var(--font-size-base);
                    color: var(--secondary-color);
                }
            }

        }
    }

    @media (max-width: 1024px) {
        .work-experience__info {
            flex-direction: column;
            gap: 0;
        }
    }

    @media (max-width: 1200px) {
        .work-experience__footer {
            flex-direction: column;
            gap: 2rem;
        }
    }

</style>
