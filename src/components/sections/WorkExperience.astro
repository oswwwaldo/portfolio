---
import { getCollection } from 'astro:content';

import SectionHeader from '../ui/SectionHeader.astro';
import ListCareerItem from '../ui/ListCareerItem.astro';
import Detail from '../ui/Detail.astro';
import StatsItem from '../ui/StatsItem.astro';
import Tag from '../ui/Tag.astro';

const experience = await getCollection('experience');
const certifications = await getCollection('certifications');
const education = await getCollection('education');
const stats = await getCollection('stats');
const technologies = await getCollection('technologies');

---

<div class="work-experience">
    <SectionHeader textContent="Work" secondLine="Experience"/>
    <div class="work-experience__history">
        {experience.toReversed().map(job => <ListCareerItem experience={job} />)}
    </div>
    <div class="work-experience__info">
        <Detail type="Certification" items={certifications.map(cert => cert.data.title )} />
        <Detail type="Education" items={education.map(school => {return `${school.data.title} - ${school.data.degree}`} )} />
    </div>
    <div class="work-experience__stats">
        { stats.map(stat =>
            <StatsItem stat={stat.data.figure} caption={stat.data.caption}/> )}
    </div>
    <div class="work-experience__tech">
        <h3> TECH STACK </h3>
        { technologies.map( tag => 
            <Tag textContent={tag.data.title}/>)}
    </div>
    <div class="work-experience__footer">
        <div class="work-experience__footer__item">
            <div class="work-experience__footer__item__header"> Based In </div>
            <div class="work-experience__footer__item__content"> New York, NY </div>
        </div>

        <div class="work-experience__footer__item">
            <div class="work-experience__footer__item__header"> GitHub </div>
            <div class="work-experience__footer__item__content"> github.com/oswwwaldo </div>
        </div>
    </div>
</div>
<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .work-experience {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5vh;

        margin-top: 10vh;

        color: var(--secondary-color);

        &__history {
            display: flex;
            flex-direction: column;
            align-items: start;
            // margin: 5vh 0;
        }

        &__info {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 32px;
            width: 100%;

            margin: 5vh 0;
        }

        &__tech {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: flex-start;
            align-content: flex-start;
            gap: 1rem;

            padding: 4rem 0;
            border-top: var(--border-thin-secondary);  
            border-bottom: var(--border-thin-secondary); 

            h3 {
                width: 100%;
            }
        }

        &__stats {
            display: grid;
            width: 100%;

            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            align-items: start;

            @media (max-width: 1000px) { 
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem; 
            }

        }

        &__footer {
            display: flex;
            flex-direction: row;
            justify-content: flex-start;
            gap: 5rem;
            width: 100%;

            &__item {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                
                &__header {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-base);
                    color: var(--color-secondary-80);
                }
                &__content {
                    font-family: var(--font-body);
                    font-size: var(--font-size-base);
                    color: var(--secondary-color);
                }
            }

        }
    }

    @media (max-width: 1024px) {
        .work-experience__info {
            flex-direction: column;
            gap: 0;
        }
    }

    @media (max-width: 425px) {
        .work-experience__footer {
            flex-direction: column;
            gap: 2rem;
        }
    }

</style>
