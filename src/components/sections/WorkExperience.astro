<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .work-experience {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5vw;

        margin-top: 10vh;

        color: var(--secondary-color);

        &__history {
            display: flex;
            flex-direction: column;
            align-items: start;

            .job {
                display: flex;
                flex-direction: row;
                justify-content: space-between;
                align-items: flex-start;
                box-sizing: border-box;

                padding: 40px 30px;
                gap: 10px;

                border-bottom: 1px solid black;
                min-height: 100px;
                width: 100%;

                &__date {
                    display: flex;
                    flex-direction: row;
                    align-items: flex-start;
                    height: 100%;
                }

                &__position {
                    display: flex;
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 1rem;

                    // // margin: 0 auto;
                    // width: 486px;
                    // height: 112px;
                    height: 100%;
                    width: fit-content;

 
                    &__title {
                        min-height: 40px;

                        font-family: var(--font-heading);
                        font-size: 32px;
                    }

                    &__company {
                        min-height: 20px;

                        font-family: var(--font-body);
                        font-size: 1.25rem;
                    }
                    &__description {
                        min-height: 35px;

                        font-family: var(--font-body);
                        font-size: 1rem;
                    }
                }

                &__skills {
                    display: flex;
                    flex-direction: row;
                    flex-wrap: wrap;
                    align-items: flex-start;
                    align-content: flex-start;
                    gap: 10px;

                    max-width: 150px;
                    height: 100%;


                    /* Inside auto layout */
                    flex: none;
                    order: 2;
                    align-self: stretch;
                    flex-grow: 0;

                }
            }
        }

        &__info {
            display: flex;
        }

        &__stats {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            align-content: center;

            width: 100%;
            min-height: 120px;
        }

        &__footer {

        }
    }

    .list-footer {
        display: flex;
        flex-direction: row;
        gap: 8rem;
        width: 100%;

        &__item {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            
            &__header {
                font-family: var(--font-heading);
                font-size: 20px;
                color: rgb(from var(--secondary-color) rgba / 0.8);
            }
            &__content {
                font-family: var(--font-body);
                font-size: 20px;
                color: var(--secondary-color);
            }
        }
    }

</style>
