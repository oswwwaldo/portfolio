---
import Icon from '../ui/AppIcon.astro';
import Button from '../ui/Button.astro';
---


<section class="hero">
    <h2 class="hero__position"> Full Stack Engineer </h2>
    <h1 class="hero__title"> Oswaldo De Los Santos </h1>
    <div class="hero__actions">
        <div class="hero__buttons">
            <Button textContent="Contact" href="/contact"></Button>
            <Button textContent="Resume" href="/resume"></Button>
        </div>
        <div class="hero__socials">
            <Icon name="fa6-solid:envelope"></Icon>
            <Icon name="fa6-brands:instagram"></Icon>
            <Icon name="fa6-brands:github"></Icon>
            <Icon name="fa6-brands:linkedin"></Icon>
        </div>
    </div>
</section>


<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .hero__wrapper {
        position: relative;
    }

    .hero {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 2rem;

        width: max-content;

        color: var(--secondary-color);
        index: 1;

        &__position {
            width: fit-content;
        }
        &__title {
            flex-grow: 1;
            width: fit-content;
            transition: text-shadow 300ms ease-out;
            
            &:hover {
                // font-weight: bold;
                text-shadow: 0 0 6px #ffffff;
            }
        }


        &__actions {
            width: fit-content;
            &__buttons {}
            
            &__socials {
                display: flex;
                gap: 1rem;
            }
        }
    }
</style>