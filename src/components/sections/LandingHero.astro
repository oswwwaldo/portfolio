---
import Icon from '../ui/AppIcon.astro';
import Button from '../ui/Button.astro';
---


<section class="hero">
    <h2 class="hero__position"> Full Stack Engineer </h2>
    <h1 class="hero__title"> Oswaldo De Los Santos </h1>
    <div class="hero__actions">
        <div class="hero__buttons">
            <Button class="hero__buttons__btn" textContent="Contact" type="button" isPrimary={true}></Button>
            <Button class="hero__buttons__btn" textContent="Resume" type="button"></Button>
        </div>
        <div class="hero__socials">
            <Icon class="hero__socials__btn" name="fa6-solid:envelope"></Icon>
            <Icon class="hero__socials__btn" name="fa6-brands:instagram"></Icon>
            <Icon class="hero__socials__btn" name="fa6-brands:github"></Icon>
            <Icon class="hero__socials__btn" name="fa6-brands:linkedin"></Icon>
        </div>
    </div>
</section>


<style lang="scss">
    @use '../../styles/variables.scss' as *;

    :root {
        --button-height: 50px;
    }

    .hero__wrapper {
        position: relative;
    }

    .hero {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 2rem;
        padding: 2rem;

        width: fit-content;

        color: var(--secondary-color);
        z-index: 1;

        &__position {
            width: fit-content;
        }
        &__title {
            flex-grow: 1;
            width: fit-content;
            transition: text-shadow 300ms ease-out;
            
            &:hover {
                text-shadow: 0 0 6px #ffffff;
            }
        }

        &__actions {
            width: fit-content;

            .hero__buttons__btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: calc(32px + var(--button-height));
                width: calc((64px * 2.5) + var(--button-height));
            }

            .hero__socials__btn {
                height: var(--button-height);
                width: var(--button-height);
            }
        }

        &__socials {
            display: flex;
            gap: 1rem;
        }
    }
</style>