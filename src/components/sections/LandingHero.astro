---
import LandingImage from '../ui/LandingImage.astro';
import stoneNotInFocus from '../../assets/media/stone-not-in-focus.jpg';
import Icon from '../ui/AppIcon.astro';
import Button from '../ui/Button.astro';
---


<section class="hero">
    
    <LandingImage 
        src={stoneNotInFocus} 
        alt="A monkey holding a phone"
        class="hero__image">
    </LandingImage>
    
    <div class="hero__text-wrapper">

        <h2 class="hero__position"> Full Stack Engineer </h2>
        
        <h1 class="hero__title"> 
            <span class="first-name"> Oswaldo </span>
            <span class="middle-name"> Fabrizio </span>
            <span class="last-name"> De Los Santos </span>
            <span class="middle-name"> Ascencio </span>
        </h1>
    </div>
    
    <div class="hero__actions">
        <div class="hero__actions-wrapper">
            <div class="hero__buttons">
                <Button class="hero__buttons__btn" textContent="Contact" type="button" isPrimary={true}></Button>
                <Button class="hero__buttons__btn" textContent="Resume" type="button" icon="fa6-solid:download"></Button>
            </div>
            
            <div class="hero__socials">
                <Icon class="hero__socials__btn" name="fa6-solid:envelope"><a href="mailto:ofdelossantosa"></a></Icon>
                <Icon class="hero__socials__btn" name="fa6-brands:instagram"><a href="instagram.com/byoswwwaldo"></a></Icon>
                <Icon class="hero__socials__btn" name="fa6-brands:github"></Icon>
                <Icon class="hero__socials__btn" name="fa6-brands:linkedin"></Icon>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    @use '../../styles/variables.scss' as *;
    /* Not the most beautiful style sheet */

    .hero {
        --hero-position-size: var(--font-size-md);
        --hero-title-size: var(--font-size-3xl);
        --hero-button-height: clamp(3.5rem, 5.625vw, 5.0625rem);
        --hero-social-icon-size: calc(var(--hero-button-height) / 2);

        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: clamp(0.5rem, 2rem, 3rem);
        padding: clamp(1.25rem, 3vw, 2rem);

        width: 100%;
        color: var(--secondary-color);
        z-index: 1;

        &__text-wrapper {
            display: contents;
        }

        &__position {
            font-size: var(--hero-position-size);
            width: fit-content;
            max-width: 100%;
            pointer-events: none;
        }
        
        &__title {
            display: flex;
            flex-wrap: wrap;
            width: auto;
            max-width: 100%;
            font-size: var(--hero-title-size);
            transition: text-shadow 300ms ease-out;

            pointer-events: none;

            :global(.dark) &:hover { 
                text-shadow: none; 
            } 

            span {
                font-family: inherit;
                font-size: inherit;
                line-height: inherit;
                pointer-events: all;


                &.middle-name {
                    display: none;
                }

                &.last-name {
                    white-space: nowrap;
                }
            }
        }

        &__actions {
            display: flex;
            flex-wrap: wrap;
            align-items: start;
            justify-content: space-between;
            gap: 1rem 1.5rem;
            width: 97%;
            max-width: 97%;
        }

        &__actions-wrapper {
            display: contents; 

            @media (max-width: 768px) {
                display: flex;
                flex-direction: row;
                flex-wrap: wrap-reverse;
                justify-content: space-between;
                gap: 1rem 1.5rem;
                width: 97%;

                & .hero__buttons {
                    gap: 0rem;
                    flex-wrap: nowrap;

                    & .hero__buttons__btn {
                        color: red;
                        max-width: 200px;
                    }
                }
            }

            @media (max-width: 425px) {
                flex-direction: column-reverse;

                & .hero__buttons {
                    justify-content: flex-start;
                    width: 100%;
                }
            }
        }

        &__buttons {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            flex-grow: 1;

            &__btn {
                flex-grow: 1;
                max-width: 250px;
            }
        }

        &__socials {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;

            &__btn {
                height: var(--hero-social-icon-size);
                width: var(--hero-social-icon-size);

                &:hover {
                    // color: var(--primary-color);
                    opacity: 60%;
                }
            }
        }
    }

    @media (max-width: 768px) {
        .hero {
            --hero-title-size: clamp(1rem, 10vw, 4rem);
            --hero-position-size: var(--font-size-sm);
            --hero-button-height: clamp(3rem, 7vw, 3.75rem);
            --hero-social-icon-size: calc(var(--hero-button-height) / 2);


            top: 20vh;
            gap: 1rem;

            &__image {
                top: 50% !important;
            }

            &__title {
                flex-basis: 100%;
                line-height: normal;

                &__span {
                    display: flex;
                    flex-wrap: wrap;

                    &.last-name {
                        white-space: revert;
                    }
                }
            }
        }
    }
</style>