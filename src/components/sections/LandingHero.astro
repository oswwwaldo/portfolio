<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .hero {
        --hero-position-size: clamp(1rem, 3vw, 32px);
        --hero-title-size: clamp(2rem, 7vw, 100px);
        --hero-button-height: clamp(3rem, 5vw, 5rem);
        --hero-social-icon-size: calc(var(--hero-button-height) / 2);

        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        
        gap: clamp(1.5rem, 4vw, 3rem);
        padding: clamp(2rem, 5vw, 4rem);
        min-height: 80vh; 
        box-sizing: border-box;

        width: 100%;
        color: var(--secondary-color);
        z-index: 1;

        pointer-events: none;
        user-select: none;

        &__position {
            font-size: var(--hero-position-size);
            width: fit-content;
            max-width: 100%;
            pointer-events: none;
            margin: 0;
        }
        
        &__title {
            display: flex;
            flex-wrap: wrap;
            gap: 0.15em 0.25em;
            width: auto;
            max-width: 100%;
            font-size: var(--hero-title-size);
            transition: text-shadow 300ms ease-out;
            margin: 0;
            pointer-events: none;

            :global(.dark) &:hover { 
                text-shadow: none; 
            } 

            span {
                font-family: inherit;
                font-size: inherit;
                line-height: inherit;
                pointer-events: all;

                &:hover {
                    text-shadow: 0 0 6px #ffffff;
                }

                &.middle-name {
                    display: none;
                }

                &.last-name {
                    white-space: nowrap;
                }
            }
        }

        &__actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
            width: 100%;
            max-width: 100%;
            margin-top: 1rem; 
        }

        &__buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

        &__socials {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;

            a {
                display: flex;
                align-items: center;
                justify-content: center;
                color: inherit;
                transition: transform 0.2s ease;
                
                &:hover {
                    transform: scale(1.1);
                }
            }

            &__btn {
                height: var(--hero-social-icon-size);
                width: var(--hero-social-icon-size);
            }
        }
    }

    @media (max-width: 768px) {
        .hero {
            --hero-title-size: clamp(1.75rem, 8vw, 3rem);
            --hero-position-size: clamp(1rem, 4vw, 1.5rem);
            --hero-button-height: clamp(3rem, 12vw, 3.5rem);

            align-items: center;
            text-align: center;
            padding: clamp(1.5rem, 5vw, 2rem);
            min-height: 90vh; 

            &__title,
            &__position {
                justify-content: center;
            }

            &__actions {
                flex-direction: column;
                justify-content: center;
                gap: 3.5rem; 
            }

            &__buttons {
                flex-direction: column; 
                width: 100%;
                max-width: 320px;

                &__btn {
                    width: 100%;
                }
            }

            &__socials {
                display: grid;
                grid-template-columns: repeat(2, auto); 
                gap: 2rem 3rem; 
                justify-content: center;
                width: auto;

                &__btn {
                    width: clamp(1.75rem, 10vw, 2.5rem);
                    height: clamp(1.75rem, 10vw, 2.5rem);
                }
            }
        }
    }
</style>