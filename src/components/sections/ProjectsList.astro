---
import ListItem from '../ui/ListItem.astro'
import Tag from '../ui/Tag.astro';
---

<div class="projects">
    <!-- Pill header -->
    <div class="projects__header">
        <h2 class="pill-header">
            <span class="pill-header__row"> A collection </span>
            <span class="pill-header__row"> 
                of my
                <span class="pill-header__image"></span>
                work
            </span>
        </h2>
    </div>

    
    <div class="projects__nav">
        <div class="projects__nav__options">
            <p class="projects__nav__options__header"> Sort by </p>
            <p class="projects__nav__options__header"> Filter by </p>
        </div>
        <div class="projects__nav__views">
            <div class="projects__nav__views__btn"> List </div>
            <div class="projects__nav__views__btn"> Cards </div>
            <div class="projects__nav__views__btn"> Panarmomic </div>
        </div>
    </div> 

    <ListItem 
        itemType = "Project"
        itemIndex = {1};
        itemTitle = "Portfolio"
        itemDescription = "Headless content management system built with Next.js, Prisma, and PostgreSQL, Full RBAC, rich text editor and asset pipeline with CDN delivery"
        itemTimeline = "2024"
        itemSkills = {["JavaScript", "Astro.js", "GSAP", "SCSS", "HTML", "Supabase"]};
    />

    <div class="project">
        <div class="project__index"> 01 </div>
        <div class="project__info">
            <div class="project__info__title"> New Tab Chess </div>
            <div class="project__info__description"> 
                Headless content management system built with Next.js, Prisma, and PostgreSQL, Full RBAC, rich text editor and asset pipeline with CDN delivery 
            </div>
            <div class="project__info__skills">
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
            </div>
        </div>
        <div class="project__date">
            <p class="project__date__text"> 2024 </p>
        </div>
    </div>

    <div class="project">
        <div class="project__index"> 01 </div>
        <div class="project__info">
            <div class="project__info__title"> New Tab Chess </div>
            <div class="project__info__description"> 
                Headless content management system built with Next.js, Prisma, and PostgreSQL, Full RBAC, rich text editor and asset pipeline with CDN delivery 
            </div>
            <div class="project__info__skills">
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
            </div>
        </div>
        <div class="project__date">
            <p class="project__date__text"> 2024 </p>
        </div>
    </div>

    <div class="project">
        <div class="project__index"> 01 </div>
        <div class="project__info">
            <div class="project__info__title"> New Tab Chess </div>
            <div class="project__info__description"> 
                Headless content management system built with Next.js, Prisma, and PostgreSQL, Full RBAC, rich text editor and asset pipeline with CDN delivery 
            </div>
            <div class="project__info__skills">
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
                <Tag textContent="Astro.js"></Tag>
            </div>
        </div>
        <div class="project__date">
            <p class="project__date__text"> 2024 </p>
