---
import { getCollection } from 'astro:content';
import PillHeader from '../ui/PillHeader.astro';
import ListProjectItem from '../ui/ListProjectItem.astro'

const projects = await getCollection('projects');
---
<section class="projects" id="projects">
    <PillHeader />
    {projects.map((project, index) => 
        <ListProjectItem project={project} index={index + 1} />
    )}
</section>
<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .projects {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 10vh 0;    
        color: var(--secondary-color);

        & div {
            background: red !important;
            border-bottom: var(--border-thin-secondary);
        }
    }
</style>