---
import ListItem from '../ui/ListItem.astro';
import PillHeader from '../ui/PillHeader.astro';
---

<div class="projects">

    <div class="projects__header">
        <PillHeader />
    </div>
    
    <div class="projects__nav">
        <div class="projects__nav__options">
            <p class="projects__nav__options__header"> Sort by </p>
            <p class="projects__nav__options__header"> Filter by </p>
        </div>
        <div class="projects__nav__views">
            <div class="projects__nav__views__btn"> List </div>
            <div class="projects__nav__views__btn"> Cards </div>
            <div class="projects__nav__views__btn"> Panarmomic </div>
        </div>
    </div> 

    <ListItem 
        itemType = "Project"
        itemIndex = {1};
        itemTitle = "Portfolio"
        itemDescription = "Headless content management system built with Next.js, Prisma, and PostgreSQL, Full RBAC, rich text editor and asset pipeline with CDN delivery"
        itemTimeline = "2024"
        itemSkills = {["JavaScript", "Astro.js", "GSAP", "SCSS", "HTML", "Supabase"]};
    />

    <ListItem 
        itemType = "Project"
        itemIndex = {2};
        itemTitle = "New Tab Chess"
        itemDescription = "Headless content management system built with Next.js, Prisma, and PostgreSQL, Full RBAC, rich text editor and asset pipeline with CDN delivery"
        itemTimeline = "2025"
        itemSkills = {["JavaScript", "Astro.js", "GSAP", "SCSS", "HTML", "Supabase"]};
    />

</div>
<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .projects {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 10vh 0; 
        color: var(--secondary-color);


        &__nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 48px 24px;
            border-bottom: var(--border-half-secondary-light);

            @media (max-width: 768px) {
                flex-direction: column;
                gap: 24px;
                padding: 0 16px 24px;
            }

            &__options,
            &__views {
                display: flex;
                gap: 32px;
                align-items: center;
            }

            &__options__header,
            &__views__btn {
                font-family: var(--font-heading);
                font-size: var(--font-size-xs);
                letter-spacing: 5.2px;
                text-transform: uppercase;
            }

            &__views__btn {
                cursor: pointer;
                transition: opacity 0.2s ease;

                &:hover {
                    opacity: 0.7;
                }
            }

            
        }
        @media (max-width: 1200px) {
            .projects__nav__options {
                width: 100%;
                justify-content: space-between;
            }

            .projects__nav__views {
                display: none;
            }
        }
        /* Individual Project Row */
        .project {
            display: grid;
            grid-template-columns: 80px 1fr 80px;
            width: 100%;
            padding: 40px 24px 96px 16px;
            border-bottom: var(--border-half-secondary-light);

            @media (max-width: 768px) {
                grid-template-columns: 1fr;
                gap: 16px;
                padding: 32px 16px 64px;
            }

            &__index {
                font-family: var(--font-heading);
                font-size: var(--font-size-xs);
                letter-spacing: 4.4px;
                padding-top: 16px; 
            }

            &__info {
                display: flex;
                flex-direction: column;
                gap: 24px;

                &__title {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-lg);
                    letter-spacing: 0.8px;
                    text-transform: uppercase;
                }

                &__description {
                    font-family: var(--font-body);
                    font-size: var(--font-size-sm);
                    line-height: 1.33;
                    letter-spacing: 0.8px;
                    max-width: 622px;
                }

                &__skills {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 12px;
                    margin-top: 24px;
                }
            }

            &__date {
                display: flex;
                justify-content: end;

                @media (max-width: 768px) {
                    justify-content: start;
                }

                &__text {
                    font-family: var(--font-body);
                    font-size: var(--font-size-xs);
                    letter-spacing: 4.08px;
                }
            }
        }
    }
</style>