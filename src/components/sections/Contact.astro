---
---

<div class="contact">
    <div class="contact__header">
        <h1> LET'S&nbsp;BUILD SOMETHING TOGETHER </h1>
    </div>
    <div class="contact__paragraph body-lg">
        Whether you have a project in mind, an opportunity to discuss or just want to say hello<br>— my inbox is always open.
    </div>
    <div class="contact__form">
        <form class="form" action="/submit-form-endpoint" method="POST">
            <div class="form__row">
                <div class="form__group">
                    <label class="form__group__label body-lg" for="name">Name</label>
                    <input class="form__group__input body-lg" type="text" id="name" name="name" required>
                </div>
                
                <div class="form__group">
                    <label class="form__group__label body-lg" for="email">Email</label>
                    <input class="form__group__input body-lg" type="email" id="email" name="email" required>
                </div>
            </div>

            <div class="form__group">
                <label class="form__group__label body-lg" for="message">Message</label>
                <textarea class="form__group__textarea body-lg" id="message" name="message" rows="5" required></textarea>
            </div>

            <button class="form__group__btn" type="submit">SEND</button>
        </form>
    </div>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .contact {
        color: var(--secondary-color);
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
        text-align: center;
        gap: 2vh;
        padding: 2rem; 

        &__header {
            display: flex;
            justify-content: center;
            width: min-content;

            line-height: normal;
        }

        &__paragraph {
            width: 100%;
            max-width: 400px; 
        }

        &__form {
            width: 100%;
            max-width: 700px;
        }
    }

    .form {
        display: flex;
        flex-direction: column; 
        gap: 4rem;
        width: 100%;
        margin-top: 3rem;

        &__row {
            display: flex;
            flex-direction: row; 
            justify-content: space-between;
            gap: 5rem; 
            width: 100%;

            .form__group {
                flex: 1; 
                margin: 0; 
            }

            @media (max-width: 768px) {
                flex-direction: column;
                gap: 4rem; 
            }
        }

        &__group {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            border-bottom: 1px solid rgb(from var(--secondary-color) r g b / 0.30); 
            width: 100%;

            &__label {
                width: 100%;
                text-align: left;
                color: gray; 
            }

            &__input, &__textarea {
                background: none;
                border: none;
                width: 100%;
                padding: 1rem 0 0.5rem 0; 
                color: var(--secondary-color);
                font-family: var(--font-body);

                &:focus {
                    border: none;
                    outline: none;
                    box-shadow: none;
                }
            }
            
            &__textarea {
                height: 50px;
                resize: vertical;
                transition: all 500ms ease-in-out;

                &:focus {
                    height: 100px;
                }
            }
            
            &__btn {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                padding: 1.5rem;
                background-color: var(--secondary-color); 
                color: var(--primary-color);
                font-family: var(--font-heading);
                font-size: var(--fs-24);
                letter-spacing: 2px;
                border: none;
                cursor: pointer;
                transition: opacity 0.3s ease;

                &:hover {
                    opacity: 0.8;
                }
            }
        }
    }
</style>    