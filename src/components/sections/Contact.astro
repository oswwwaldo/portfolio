---
import Button from '../ui/Button.astro';
--- 

<div class="contact">
    <div class="contact__header">
        <h1> LET'S&nbsp;BUILD SOMETHING TOGETHER </h1>
    </div>
    <div class="contact__paragraph">
        Whether you have a project in mind, an opportunity to discuss or just want to say hello<br>— my inbox is always open.
    </div>
    <div class="contact__form">
        <form class="form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value="951f402b-8b91-464a-bfd3-f59235c06a26">
            <input type="hidden" name="subject" value="New Submission from Web3Forms">
            <input type="checkbox" name="botcheck" id="" style="display: none;">

            <div class="form__row">
                <div class="form__group">
                    <label class="form__group__label" for="name">Name</label>
                    <input class="form__group__input" type="text" id="name" name="name" required>
                </div>
                
                <div class="form__group">
                    <label class="form__group__label" for="email">Email</label>
                    <input class="form__group__input" type="email" id="email" name="email" required>
                </div>
            </div>

            <div class="form__group">
                <label class="form__group__label" for="message">Message</label>
                <textarea class="form__group__textarea" id="message" name="message" rows="5" required></textarea>
            </div>

            <Button class="form__group__btn" textContent="SEND" type="submit" variant="primary"></Button>

            <div class="form__result" id="contact-form-result"></div>
        </form>
    </div>
</div>

<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .contact {
        color: var(--secondary-color);
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
        text-align: center;
        gap: 2vh;
        padding: 2rem; 


        &__header {
            display: flex;
            justify-content: center;
            width: min-content;

            line-height: normal;

            h1 {
                font-size: var(--font-size-2xl);
            }
        }

        &__paragraph {
            width: 100%;
            max-width: 400px; 
            font-size: var(--font-size-base);
        }

        &__form {
            width: 100%;
            max-width: 700px;
        }
    }

    .form {
        display: flex;
        flex-direction: column; 
        gap: 4rem;
        width: 100%;
        margin-top: 3rem;

        &__row {
            display: flex;
            flex-direction: row; 
            justify-content: space-between;
            gap: 5rem; 
            width: 100%;

            .form__group {
                flex: 1; 
                margin: 0; 
            }

            @media (max-width: 768px) {
                flex-direction: column;
                gap: 4rem; 
            }
        }

        &__group {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            border-bottom: var(--border-thin-secondary-20); 
            width: 100%;
            transition: border-bottom-color 0.3s ease;

            &:focus-within {
                border-bottom: 1px solid var(--secondary-color); 
            }

            &__label {
                width: 100%;
                text-align: left;
                color: var(--color-gray); 
                font-size: var(--font-size-base);
            }

            &__input, &__textarea {
                background: transparent;
                border: none;
                width: 100%;
                padding: 1rem 0.5rem 0.5rem 0.5rem; 
                color: var(--secondary-color);
                font-family: var(--font-body);
                font-size: var(--font-size-base);

                &:focus {
                    border: none;
                    outline: none;
                    box-shadow: none;
                }

                &:-webkit-autofill,
                &:-webkit-autofill:hover, 
                &:-webkit-autofill:focus {
                    -webkit-text-fill-color: var(--secondary-color);
                    box-shadow: 0 0 0px 1000px var(--color-secondary-05) inset;
                    transition: background-color 5000s ease-in-out 0s;
                }

            }
            
            &__textarea {
                height: 50px;
                resize: vertical;
                transition: all 500ms ease-in-out;

                &:focus {
                    height: 100px;
                }
            }
            
            &__btn {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                padding: 1.5rem;
                background-color: var(--secondary-color); 
                color: var(--primary-color);
                font-family: var(--font-heading);
                font-size: var(--font-size-base);
                border: none;
                cursor: pointer;
                transition: opacity 0.3s ease;

                &:hover {
                    opacity: 0.8;
                }
            }
        }

        &__result {
            text-align: center;
            font-size: var(--font-size-base);
            color: var(--secondary-color);
            margin-top: -1.5rem; 
            min-height: 24px;
            font-weight: 500;
        }
    }
</style>    

<script>
    window.onload = function() {
        (document.getElementById('myForm') as HTMLFormElement).reset();
    }

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const result = document.getElementById('contact-form-result');

    if (form && result) {

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(form);
            const object = Object.fromEntries(formData);
            const json = JSON.stringify(object);
            result.innerHTML = "Please wait..."

            fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: json
            })
            .then(async (response) => {
                let json = await response.json();
                if (response.status == 200) {
                    result.innerHTML = json.message;
                } else {
                    console.log(response);
                    result.innerHTML = json.message;
                }
            })
            .catch(error => {
                console.log(error);
                result.innerHTML = "Something went wrong!";
            })
            .then(function() {
                form.reset();
                setTimeout(() => {
                    result.style.display = "none";
                }, 3000);
            });
        });
    }
</script>