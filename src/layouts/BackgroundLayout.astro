---
import Background from '../components/ui/Background.astro';
---

<div class="site__wrapper">
  <div class="site__wrapper__background">
    <Background />
  </div>
  <div class="site__wrapper__scroll-indicator"></div>
  <slot />
</div>

<style lang="scss">
  .site__wrapper {
    position: relative;
    min-height: 100vh;
    overflow-x: clip;

    display: grid;
    grid-template-rows: 1fr;
    grid-template-columns: minmax(0, 1fr) [outer-left] repeat(4, minmax(0, 1fr)) [outer-right] minmax(0, 1fr);

    z-index: -50;
    
    &__background {
      grid-column: 1 / -1;
      grid-row: 1 / -1;
      z-index: 0;
      pointer-events: none;
    }

    &__scroll-indicator {
        grid-column: 6;
        grid-row: 1 / -1;
        z-index: 0;
        pointer-events: none;
        background-color: var(--primary-color);
        opacity: 20%;
    }
  }

  @media (max-width: 770px) {
    .site__wrapper {
      grid-template-columns: minmax(1rem, 1fr) repeat(4, minmax(0, 1fr)) minmax(1rem, 1fr);
    }

    .site__wrapper__scroll-indicator {
      grid-column: 1 / -1;
    }
  }
</style>