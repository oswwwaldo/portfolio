---
import Background from '../components/ui/Background.astro';
---

<div class="grid">
  <div class="grid__content">
    <slot />
  </div>
</div>

<style lang="scss">
  .grid {
    min-height: 100vh;
    overflow-x: clip;

    display: grid;
    grid-template-rows: 1fr;
    grid-template-columns: minmax(0, 1fr) [outer-left] repeat(4, minmax(0, 1fr)) [outer-right] minmax(0, 1fr);
    margin-top: 25vh;

    &__background {
      grid-column: 1 / -1;
      grid-row: 1 / -1;
      z-index: 0;
      pointer-events: none;
    }

    /* This is where most of the site's content will live */
    &__content {
      grid-column: outer-left / outer-right;
      grid-row: 1 / -1;
      z-index: 1;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 25vh;
    }
  }

  @media (max-width: 770px) {
    .grid {
      grid-template-columns: minmax(1rem, 1fr) repeat(4, minmax(0, 1fr)) minmax(1rem, 1fr);
    }

    .grid__content {
      grid-column: 1 / -1;
      padding-inline: clamp(1rem, 3vw, 1.5rem);
    }
  }
</style>