<div class="grid">
  <div class="grid__content">
    <slot />
  </div>

  <div class="bg-scroll-indicator"></div>
</div>

<style lang="scss">
  .grid {
    position: relative;
    min-height: 100dvh;
    overflow-x: clip;

    display: grid;
    grid-template-rows: 1fr;
    grid-template-columns: minmax(0, 1fr) [outer-left] repeat(4, minmax(0, 1fr)) [outer-right] minmax(0, 1fr);
    &__background {
      grid-column: 1 / -1;
      grid-row: 1 / -1;
      z-index: 0;
      pointer-events: none;
    }

    &__content {
      grid-column: outer-left / outer-right;
      grid-row: 1 / -1;
      z-index: 1;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 10vh;
    }
  }

  .bg-scroll-indicator {
    grid-column: 6;
    grid-row: 1 / -1;
    z-index: var(--bg-decor-layer);
    pointer-events: none;
    background-color: var(--color-secondary-05);
    opacity: 20%;

    position: sticky;
    top: 0;
    right: 100%;
    left: 100%;

    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 770px) {
    .grid {
      grid-template-columns: minmax(1rem, 1fr) repeat(4, minmax(0, 1fr)) minmax(1rem, 1fr);
    }

    .grid__content {
      grid-column: 1 / -1;
      padding-inline: clamp(1rem, 3vw, 1.5rem);
    }

    .bg-scroll-indicator {
      grid-column: 1 / -1;
    }
  }
</style>