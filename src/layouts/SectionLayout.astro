---

type Props = {
    noMargins?: boolean;
    justifyCentered?: boolean;
    firstLayout?: boolean;
    background?: boolean;
}

const { noMargins = false, justifyCentered = false, firstLayout = false, background = false } = Astro.props

---
<section class:list={['section', { 'no-margins': noMargins, 'centered': justifyCentered, 'starter': firstLayout, }]}>
    <slot />
</section>

<style lang="scss">
    @use '../styles/variables.scss' as *;
    .section {
        display: flex;
        flex-direction: column;
        margin: 0 var(--grid-margin);
        padding: clamp(1.25rem, 3vw, 2rem);
        
        @media (max-width: 768px) {
            margin: 0 10vw;
            padding: 0;
        }

        &.no-margins {
            margin: 0;
            padding: 0;
        }

        &.centered {
            align-items: center;
            justify-content: center;
        }

        &.starter {
            height: 100dvh;
        }
    }

</style>