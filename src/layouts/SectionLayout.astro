---
type Props = {
    noMargins?: boolean;
}

const { noMargins = false } = Astro.props

---
<section class:list={['section', { 'no-margins': noMargins }]}>
    <slot />
</section>

<style lang="scss">
    @use '../styles/variables.scss' as *;
    .section {
        display: flex;
        flex-direction: column;
        margin: 0 var(--grid-margin);
        padding: clamp(1.25rem, 3vw, 2rem);

        @media (max-width: 770px) {
            --grid-margin: clamp(1rem, 3vw, 1.5rem);
        }

        &.section.no-margins {
            margin: 0;
        }
    }

</style>