---
import Background from '../components/ui/Background.astro';
---

<div class="section">
  <div class="section__background">
    <Background />
  </div>

  <div class="section__content">
    <slot />
  </div>

  <!-- These are helper lines to track [outer-left] & [outer-right] grid lines and sync them with <GridLines> -->
  <div class="red-line left-line"></div>
  <div class="red-line right-line"></div>
</div>

<style lang="scss">
    .section {
        position: relative;
        min-height: 100vh;
        overflow-x: clip;

        display: grid;
        grid-template-rows: 1fr;
        grid-template-columns: minmax(0, 1fr) [outer-left] repeat(4, minmax(0, 1fr)) [outer-right] minmax(0, 1fr);        

        &__background {
          grid-column: 1 / -1;
          grid-row: 1 / -1;
          z-index: 0;
          pointer-events: none;
        }

        &__content {
          grid-column: outer-left / outer-right;
          grid-row: 1 / -1;
          z-index: 1;

          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;
        }
    }

    .red-line {
      background: red;
      width: 1px;
      height: 100vh;
      grid-row: 1 / -1;
      z-index: 9999;
      pointer-events: none;
    }

    .left-line {
      grid-column: outer-left;
      justify-self: start;
    }

    .right-line {
      grid-column: outer-right;
      justify-self: start;
    }

    // .section__background {
