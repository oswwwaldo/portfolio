---

type Props = {
    noMargins?: boolean;
    background?: boolean;
}

const { noMargins = false, background = false } = Astro.props

---
<section class:list={['section', { 'no-margins': noMargins }]}>
    <slot />
</section>

<style lang="scss">
    @use '../styles/variables.scss' as *;
    .section {
        display: flex;
        flex-direction: column;
        margin: 0 var(--grid-margin);
        padding: clamp(1.25rem, 3vw, 2rem);
        
        @media (max-width: 768px) {
            margin: 0 2vw;
            padding: 0;
        }

        &.section.no-margins {
            margin: 0;
            padding: 0;
        }
    }

</style>