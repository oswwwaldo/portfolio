---
import BaseLayout from "../layouts/BaseLayout.astro";
import GridLayout from "../layouts/GridLayout.astro";
import SectionLayout from "../layouts/SectionLayout.astro";
import LandingHero from "../components/sections/LandingHero.astro";
import TransitionStatement from "../components/sections/TransitionStatement.astro";
import SelectedWorks from "../components/sections/SelectedWorks.astro";
import WorkExperience from "../components/sections/WorkExperience.astro";
import ProjectsList from "../components/sections/ProjectsList.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import Contact from "../components/sections/Contact.astro";
        
const title = "oswaldo de los santos (@byoswwwaldo) — ✦";
const description = "Portfolio of Oswaldo de los Santos featuring selected projects, experience highlights, and creative web experiments.";
// ♪ ♫  𓆝 𓆟 𓆞 ✦
---

<BaseLayout title={title} description={description}>
    <div class="portfolio">
        <GridLayout>
            <LandingHero/>
        </GridLayout>

        <SectionLayout>
            <TransitionStatement/>
        </SectionLayout>

        <SectionLayout>
            <SelectedWorks/>
        </SectionLayout>

        <SectionLayout>
            <WorkExperience/>
        </SectionLayout>

        <SectionLayout>
            <ProjectsList/>
        </SectionLayout>

        <SectionLayout>
            <Contact/>
        </SectionLayout>
    </div>
</BaseLayout>

<style lang="scss">
  .portfolio {
    display: flex;
    flex-direction: column;
    gap: 5vh;
  }
</style>
