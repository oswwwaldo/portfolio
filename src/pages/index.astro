const pageTitle = "oswwwaldo"
const today = new Date().toLocaleDateString('en-US');

const pages = [
  { title: "Core", slug: "/", completed: true },
  { title: "Home", slug: "/home", completed: false },
  { title: "About", slug: "/about", completed: false },
  { title: "Projects", slug: "/projects", completed: false },
  { title: "Contact", slug: "/contact-us", completed: false },
  { title: "Resume", slug: "/resume", completed: false },
  { title: "Now", slug: "/now", completed: false },
  { title: "Gallery", slug: "/gallery", completed: false },
