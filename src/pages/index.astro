---
import BaseLayout from '../layouts/BaseLayout.astro';
import GridLayout from '../layouts/GridLayout.astro';
import SectionLayout from '../layouts/SectionLayout.astro';
import LandingHero from '../components/sections/LandingHero.astro';
import TransitionStatement from '../components/sections/TransitionStatement.astro';
import SelectedWorks from '../components/sections/SelectedWorks.astro';
import WorkExperience from '../components/sections/WorkExperience.astro';
import ProjectsList from '../components/sections/ProjectsList.astro';
import AboutMe from '../components/sections/AboutMe.astro';
import Contact from '../components/sections/Contact.astro';
import TagCloud from '../components/sections/TagCloud.astro';

// import LogoLoop from '../components/ui/LogoLoop.astro';

// const pageTitle = "oswwwaldo"
const pageTitle = "oswaldo de los santos (@byoswwwaldo)";
const today = new Date().toLocaleDateString('en-US');

const pages = [
  { title: "Core", slug: "/", completed: true },
  { title: "Home", slug: "/home", completed: false },
  { title: "About", slug: "/about", completed: false },
  { title: "Projects", slug: "/projects", completed: false },
  { title: "Contact", slug: "/contact-us", completed: false },
  { title: "Resume", slug: "/resume", completed: false },
  { title: "Now", slug: "/now", completed: false },
  { title: "Gallery", slug: "/gallery", completed: false },
  { title: "Video", slug: "/video", completed: false },
  { title: "Thoughts", slug: "/blog", completed: false },
];

const languages = ["English", "Español", "Français"];

---

<BaseLayout pageTitle={pageTitle}>
  <GridLayout>
    <LandingHero />
  </GridLayout>

  <div class="portfolio">
    <SectionLayout>
      <TransitionStatement /> 
    </SectionLayout>
    
    <SectionLayout>
      <SelectedWorks />
    </SectionLayout>
    
    
    <SectionLayout>
      <WorkExperience />
    </SectionLayout>
    
    <SectionLayout>
      <ProjectsList />
    </SectionLayout>
    
    <SectionLayout>
      <AboutMe />
    </SectionLayout>
    
    <SectionLayout>
      <Contact />
    </SectionLayout>  
  </div>
    

  <!-- 
  <SectionLayout>
    <TagCloud />
  </SectionLayout>
   -->
  
</BaseLayout>


<style lang="scss">
    .portfolio {
        display: flex;
        flex-direction: column;
        gap: 5vh;
    }
</style> 

