---
import BaseLayout from '../layouts/BaseLayout.astro';
import GridLayout from '../layouts/GridLayout.astro';
import SectionLayout from '../layouts/SectionLayout.astro';

const title = "gallery — oswaldo de los santos (@byoswwwaldo)";
const description = "A gallery page for visual experiments and creative snapshots from Oswaldo de los Santos.";

---

<BaseLayout title={title} description={description}>
  <SectionLayout firstLayout={true} justifyCentered={true}>
    <h1> Gallery </h1>
  </SectionLayout>
</BaseLayout>

<style lang="scss">
    @use '../styles/variables.scss' as *;
    h1 {
      color: var(--secondary-color);
    }
</style>
