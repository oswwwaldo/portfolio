---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import GridLayout from '../layouts/GridLayout.astro';
import SectionLayout from '../layouts/SectionLayout.astro';

const pageTitle = "thoughts — oswaldo de los santos (@byoswwwaldo)";
const thoughts = await getCollection('thoughts')

import throne from '../assets/throne.jpg';
---

<BaseLayout pageTitle={pageTitle}>
  <SectionLayout firstLayout={true} justifyCentered={true}>
    <div class="section">
        <div class="section__landing">
            <Image class="section__landing__image" src={throne} alt="wal-ta"/>
            <h1 class="section__landing__header"> Thoughts </h1>
        </div>
    </div>
  </SectionLayout>
</BaseLayout>

<style lang="scss">
    @use '../styles/variables.scss' as *;
    
    h1 {
      color: var(--secondary-color);
    }
    .section {
        display: flex;
        flex-flow: column nowrap;
        justify-content: center; 
        color: var(--secondary-color, #ffffff);
        position: relative;
        height: 100dvh;

        &__landing {
            display: flex;
            flex-flow: column nowrap;

            &__header {
                position: absolute;
                top: 50%; left: 50%;
                transform: translate(-50%, -50%);
                width: max-content;

                font-size: var(--font-size-3xl);
                text-align: center;
            }

            &__image {
                height: 50vh;
                width: 100%;
                filter: brightness(0.1);
            }

        }
    }
</style>