---
import { getCollection } from "astro:content";
import { render } from "astro:content";
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionLayout from "../../layouts/SectionLayout.astro";
import LandingImage from '../../components/ui/LandingImage.astro';

export async function getStaticPaths() {
    const thoughts = await getCollection('thoughts')

    return thoughts.map((thought) => {
        return {
            params: { id: thought.id },
            props: { thought }
        }
    })
}

const { thought } = Astro.props
const { Content } = await render(thought);

const title = `${thought.data.title} — oswaldo de los santos (@byoswwwaldo)`;
const description = thought.data.description;

---

<BaseLayout title={title} description={description}>
    <SectionLayout firstLayout={false} justifyCentered={true} topPadding={true}>
        <div class="article-intro">
            <h1 class="article-intro__heading"> {thought.data.short} </h1>

            <LandingImage 
                src={thought.data.thumbnail.cover} 
                alt={thought.data.thumbnail.coverAlt}
                topPosition="7.5%"
                leftPosition="50%"
                class="article-intro__image">
            </LandingImage> 

        </div>

        <div class="thought-article">
            <Content />
        </div>
    </SectionLayout>
</BaseLayout>
<style lang="scss">
    @use '../../styles/variables.scss' as *;

    .article-intro {
        color: var(--secondary-color);
        height: 100dvh;

        &__heading {
            font-size: var(--font-size-2xl);
        }
        &__image {
            background: red;
            position: absolute;
            top: 0% !important;
        }
    }
    .thought-article {
        background: var(--color-secondary-40);
        color: var(--secondary-color);
    }

</style>