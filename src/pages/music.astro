<!-- <script src="../scripts/my-script.ts"></script> -->
<script>
    // @ts-nocheck
    import music from '../data/music.json';
    const ytMenu = document.querySelector('.music__select');

    // ! This should be refactored and baked into get-yt-data-json.js 

    for (const playlist in music) {
        console.log(playlist, music[playlist]);

        const PLAYLIST_TAGS = {
            'PLfPCDW7xyAww': 'Moon',
            'PLUNtUmhxA3zm779NGq3Na99MX7B8L3X3K': 'Foda',
            'PLUNtUmhxA3zlJJrCJmcYWHGB9g4lP0GW5': 'Edits',
            'PLUNtUmhxA3zmaC2NgXLoEFsPJ5B9fTVHP': 'Cry',
            'PLUNtUmhxA3zm_N4Kg53VY9TkHgtaeImsb': 'Oiseaux',
            'PLUNtUmhxA3znFD2M0yCqVw4wyozMco0Xo': "L'amore",
        };

        const tag = PLAYLIST_TAGS[playlist];
        if (tag === undefined) {
            throw new Error("Not expected in predefined set: " + playlist);
        }

        if (ytMenu) {
            const itemDiv = document.createElement('div');
            itemDiv.classList.add('item');
            itemDiv.textContent = tag;  
            ytMenu.appendChild(itemDiv);
        }
    }


    const ytPlayer = document.getElementById("ytplayer");

    if (ytPlayer) {

        ytPlayer.setAttribute('tabindex', '-1');
        ytPlayer.setAttribute('aria-hidden', 'true');

        // window.scrollTo({ top: 0, behavior: 'smooth' });

        // Load the YouTube iFrame Player API code asynchronously
        var tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        var firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag?.parentNode?.insertBefore(tag, firstScriptTag);
        console.log(tag);
        console.log(firstScriptTag);

        declare global {
            interface Window {
                myCustomProperty: string;
                myCustomMethod: (param: number) => void;
                onYouTubeIframeAPIReady: () => void;
                onPlayerReady: (event: any) => void;
                onPlayerStateChange: (event: any) => void;
                stopVideo: () => void;
            }
        }

        var player: any;

        window.onYouTubeIframeAPIReady = function onYouTubeIframeAPIReady() {
            console.log("onYouTubeiFrameAPIReady func called");
            player = new YT.Player('ytplayer', {
                height: '200',
                width: '200',
                videoId: 'M7lc1UVf-VE',
                playerVars: {
                    'playsinline': 1
                },
                events: {
                    'onReady': onPlayerReady,
                    'onStateChange': onPlayerStateChange
                }
            });
        }

        window.onPlayerReady = function onPlayerReady(event: any) {
            event.target.playVideo();
        }

        var done = false;
        window.onPlayerStateChange = function onPlayerStateChange(event: any) {
            if (event.data == YT.PlayerState.PLAYING && !done) {
                // setTimeout(stopVideo, 6000);
                done = true;
            }
        }
        window.stopVideo = function stopVideo() {
            player.stopVideo();
        }
    }
</script>