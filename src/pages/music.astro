---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLayout from '../layouts/SectionLayout.astro';
import TagCloud from '../components/sections/TagCloud.astro';
import Button from '../components/ui/Button.astro';

const pageTitle = "♪ — oswaldo de los santos (@byoswwwaldo)";
---

<BaseLayout pageTitle={pageTitle}>
    <SectionLayout firstLayout={true} justifyCentered={true} noPadding={true}>
        <div class="music">
            <h1 class="music__header"> 
                music player
            </h1>
            <div class="music__select">
                <!-- <TagCloud /> -->
                <!-- 
                <iframe 
                    id="ytplayer" 
                    type="text/html" 
                    width="1200" 
                    height="200" 
                    src="https://www.youtube.com/embed/?controls=0&enablejsapi=1&list=PLUNtUmhxA3zmaC2NgXLoEFsPJ5B9fTVHP&listType=playlist&color=white"
                    allowfullscreen /> 
                -->

                <div id="ytplayer"></div>
            </div>
            <div class="music__player">
                <Button  
                    icon = "mynaui:skip-back",
                    variant = "tertiary",
                    shape = "default",
                    size = "md",
                    class = "music__player__btn"></Button>
                <Button 
                    icon = "mynaui:pause",
                    variant = "tertiary",
                    shape = "default",
                    size = "md",
                    class = "music__player__btn"></Button>
                <Button 
                    icon = "mynaui:play",
                    variant = "tertiary",
                    shape = "default",
                    size = "md",
                    class = "music__player__btn"></Button>
                    
                <Button 
                    icon = "mynaui:skip-forward",
                    variant = "tertiary",
                    shape = "default",
                    size = "md",
                    class = "music__player__btn"></Button>

                    <!-- 
                     mynaui:spotify 
                     mynaui:repeat
                     mynaui:shuffle 
                     mynaui:sort
                     mynaui:pin
                     mynaui:play-square
                     mynaui:pause-circle-->
            </div>
        </div>
    </SectionLayout>
</BaseLayout>

<style lang="scss">
    @use '../styles/variables.scss' as *;

    #ytplayer {
        position: absolute;
        top: -999999999999;
        left: -99999999999;
        opacity: 0.0000001;
    }

    .music {
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
        gap: 1rem;

        width: 100%;
        
        color: var(--secondary-color);

        &__header {
            color: inherit;
        }

        &__player {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            color: inherit;
            width: 100%;

            display: grid;
            grid-template-columns: repeat(4, 1fr);
            justify-items: center;
        }
    }
</style>

<script>
  const hello: string = "Hello world."
  console.log(hello)
</script>

<!-- <script src="../scripts/my-script.ts"></script> -->
<script>
    const ytPlayer = document.getElementById("ytplayer");

    // const joe: string = "Joe Biden."
    // console.log(joe)
    console.log("Donald Trump")

    // let username = prompt("Please enter your name:");
    // let proceed = confirm("Are you sure you want to delete this?"); //
    // window.scrollTo({ top: 0, behavior: 'smooth' });
    // alert('hi')

    // Load the YouTube iFrame Player API code asynchronously
    var tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    var firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag?.parentNode?.insertBefore(tag, firstScriptTag);
    console.log(tag);
    console.log(firstScriptTag);

    // src/index.ts (or any file with imports/exports)

    // 1. Extend the Window interface
    declare global {
        interface Window {
            myCustomProperty: string;
            myCustomMethod: (param: number) => void;
            onYouTubeIframeAPIReady: () => void;
            onPlayerReady: (event: any) => void;
            onPlayerStateChange: (event: any) => void;
            stopVideo: () => void;
        }
    }

    // 2. Use the properties safely
    window.myCustomProperty = "Hello World";
    window.myCustomMethod = (num) => console.log(num);

    var player: any;

    window.onYouTubeIframeAPIReady = function onYouTubeIframeAPIReady() {
        console.log("onYouTubeiFrameAPIReady func called");
        player = new YT.Player('ytplayer', {
            height: '200',
            width: '200',
            videoId: 'M7lc1UVf-VE',
            playerVars: {
                'playsinline': 1
            },
            events: {
                'onReady': onPlayerReady,
                'onStateChange': onPlayerStateChange
            }
        });
        console.log("onYouTubeiFrameAPIReady func constructed");
    }

    window.onPlayerReady = function onPlayerReady(event: any) {
        event.target.playVideo();
        console.log("onPlayerReady event fired, target.playVideo(); ");
    }

    var done = false;
    window.onPlayerStateChange = function onPlayerStateChange(event: any) {
        if (event.data == YT.PlayerState.PLAYING && !done) {
            // setTimeout(stopVideo, 6000);
            done = true;
        }
    }
    window.stopVideo = function stopVideo() {
        player.stopVideo();
    }

</script>