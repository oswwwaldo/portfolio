---
import BaseLayout from '../layouts/BaseLayout.astro';
import GridLayout from '../layouts/GridLayout.astro';
import SectionLayout from '../layouts/SectionLayout.astro';

const title = "guestbook — oswaldo de los santos (@byoswwwaldo)";
const description = "Leave a note and connect through the guestbook on Oswaldo de los Santos' portfolio.";

---

<BaseLayout title={title} description={description}>
  <SectionLayout firstLayout={true} justifyCentered={true}>
    <h1> Guestbook </h1>
  </SectionLayout>
</BaseLayout>

<style lang="scss">
    @use '../styles/variables.scss' as *;
    h1 {
      color: var(--secondary-color);
    }
</style>
