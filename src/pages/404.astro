---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLayout from "../layouts/SectionLayout.astro";

const pageTitle = "404 - oswaldo de los santos (@byoswwwaldo)";
---

<BaseLayout pageTitle={pageTitle} noFooter={true} noEOF={true} noPageMargin={true}>
    <SectionLayout noMargins={true}>
        <section class="not-found">
            <div class="text-group">
                <h1 class="not-found__header">Page not found</h1>
                <h2 class="not-found__caption">We couldn't find that page</h2>
            </div>
            <div class="footer-nav">
                <div class="footer-nav__option">
                    <a class="footer-nav__option__link" href="/about">
                        About
                    </a>
                </div>
                <div class="footer-nav__option">
                    <a class="footer-nav__option__link" href="/"> Home </a>
                </div>
                <div class="footer-nav__option">
                    <a class="footer-nav__option__link" href="/Projects">
                        Projects
                    </a>
                </div>
                <div class="footer-nav__option">
                    <a class="footer-nav__option__link" href="/Contact">
                        Contact
                    </a>
                </div>
                <div class="footer-nav__option">
                    <a class="footer-nav__option__link" href="/Resume">
                        Resume
                    </a>
                </div>
            </div>
        </section>
    </SectionLayout>
</BaseLayout>

<style lang="scss">
    @use "../styles/variables.scss" as *;

    .not-found {
        display: flex;
        flex-direction: column;
        justify-content: center;

        position: relative;
        min-height: 100dvh;
        width: 100%;

        .text-group {
            display: flex;
            align-items: center;
            flex-direction: column;
            justify-content: center;

            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -70%);
            
            width: 100%;
            padding: 0 1rem;
            text-align: center;
        }
        &__header {
            font-size: var(--font-size-3xl);
            text-align: left;
            color: var(--secondary-color);
        }
        &__caption {
            color: var(--secondary-color);
            text-align: left;
        }

        .footer-nav {
            display: flex;
            align-items: center;
            flex-direction: row;


            position: absolute;
            left: 0; bottom: 0;

            width: 100%;
            padding: 2rem 1rem;
            margin: 0 auto;

            border-top: var(--border-thin-secondary);

            &__option {
                display: flex;
                flex-direction: column;
                justify-content: space-around;
                align-items: center;
                gap: 3.5rem;

                width: 100%;    

                &__link {
                    font-family: var(--font-heading);
                    font-size: var(--font-size-md);
                    color: var(--secondary-color);

                    text-decoration: none;
                    transition: opacity 0.2s ease;

                    &:hover {
                        opacity: 0.7;
                    }
                }
            }
        }
    }

    @media (max-width: 768px) {
        .not-found {
            flex-direction: column;
            text-align: left;

            .text-group {
                position: revert;
                transform: revert;
                text-align: left;
                padding: 1rem;
                align-items: flex-start;
            }
            .footer-nav {
                align-items: center;
                flex-direction: column;
                justify-content: flex-start;

                border-top: none;

                position: revert;
                transform: revert;
                text-align: left;

                &__option {
                    align-items: flex-start;
                }
            }
        }
    }
</style>
