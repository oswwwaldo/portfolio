---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLayout from '../layouts/SectionLayout.astro';
import ScrollGallery from '../components/sections/ScrollGallery.astro';

const title = "drop — oswaldo de los santos (@byoswwwaldo)";
const description = "A full-screen scroll gallery experiment from Oswaldo de los Santos.";

---

<BaseLayout title={title} description={description} fullScreen={true}>
  <SectionLayout firstLayout={true} justifyCentered={true}>
    <ScrollGallery/>
  </SectionLayout>
</BaseLayout>
