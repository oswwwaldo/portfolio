---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLayout from '../layouts/SectionLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ScrollGallery from '../components/sections/ScrollGallery.astro';

const pageTitle = "credits — oswaldo de los santos (@byoswwwaldo)";

---
<BaseLayout pageTitle={pageTitle} fullScreen={true}>
  <SectionLayout firstLayout={true} justifyCentered={true}>
    <section class="credits">
        <SectionHeader textContent="Credits & Attributions" />
        <ul>
            <li> Astro.js </li>
            <li> GSAP </li>
            <li> Gianluca Gradgonga </li>
            <li> Nico Aroca </li>
            <li> Infinity Blade </li>
        </ul>

        <section>
            <h3>Assets & Design</h3>
            <ul>
                <li><strong>Icons:</strong> <a href="https://fontawesome.com" target="_blank" rel="noopener">FontAwesome</a> (CC BY 4.0 License)</li>
                <li><strong>Illustrations:</strong> <a href="https://undraw.co" target="_blank" rel="noopener">unDraw</a> by Katerina Limpitsouni</li>
            </ul>
        </section>

        <section>
            <h3>Open Source & Tools</h3>
            <ul>
                <li><strong>Theme Inspiration:</strong> Clean layout inspired by <a href="https://brittanychiang.com" target="_blank" rel="noopener">Brittany Chiang</a></li>
                <li>
                    <strong>/music API Data:</strong> 
                     Music functionality powered by the 
                    <a href="https://developers.google.com/youtube/v3" target="_blank" rel="noopener">YouTube Data v3 API</a>
                    and 
                    <a href="https://developers.google.com/youtube/iframe_api_reference" target="_blank" rel="noopener">YouTube iFrame Player API</a>                    
                </li>
            </ul>
        </section>

        <!-- <section>
            <h3>Tutorials & Learning</h3>
            <ul>
                <li><strong>E-Commerce Project:</strong> Base backend architecture adapted from Brad Traversy's <a href="https://traversymedia.com" target="_blank" rel="noopener">MERN Course</a>. Frontend UI and component logic completely customized by me.</li>
            </ul>
        </section> -->
    </section>
  </SectionLayout>
</BaseLayout>

<style lang="scss">
    @use '../styles/variables.scss' as *;

    .credits {
      color: var(--secondary-color);
    }
</style>
